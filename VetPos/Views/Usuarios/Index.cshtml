            </div>
            <div class="user-details">
                <div class="detail-item">
                    <span class="detail-label">Rol:</span>
                    <span class="role-badge role-vet">Veterinario</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Email:</span>
                    <span class="detail-value">carlos.rodriguez@vetpost.com</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Teléfono:</span>
                    <span class="detail-value">+1 234-567-8901</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Último acceso:</span>
                    <span class="detail-value">14/10/2024 16:45</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Estado:</span>
                    <span class="status-active">Activo</span>
                </div>
            </div>
            <div class="user-actions">
                <button class="btn btn-primary btn-sm">
                    <i class="fas fa-edit"></i> Editar
                </button>
                <button class="btn btn-info btn-sm">
                    <i class="fas fa-key"></i> Contraseña
                </button>
            </div>
        </div>

        <!-- Usuario 3 -->
        <div class="user-card">
            <div class="user-header">
                <div class="user-avatar">A</div>
                <div class="user-info">
                    <h3>Dra. Ana García</h3>
                    <p>ana.vet</p>
                </div>
            </div>
            <div class="user-details">
                <div class="detail-item">
                    <span class="detail-label">Rol:</span>
                    <span class="role-badge role-vet">Veterinario</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Email:</span>
                    <span class="detail-value">ana.garcia@vetpost.com</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Teléfono:</span>
                    <span class="detail-value">+1 234-567-8902</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Último acceso:</span>
                    <span class="detail-value">15/10/2024 09:15</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Estado:</span>
                    <span class="status-active">Activo</span>
                </div>
            </div>
            <div class="user-actions">
                <button class="btn btn-primary btn-sm">
