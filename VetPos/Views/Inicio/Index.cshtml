                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Modal para nueva cita -->
<div id="nuevaCitaModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title">Agendar Nueva Cita</h3>
            <button class="close" onclick="closeModal('nuevaCitaModal')">&times;</button>
        </div>

        <form>
            <div class="form-group">
                <label class="form-label">Cliente</label>
                <select class="form-control">
                    <option>Seleccionar cliente</option>
                    <option>María González</option>
                    <option>Carlos López</option>
                    <option>Ana Martínez</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Mascota</label>
                <select class="form-control">
                    <option>Seleccionar mascota</option>
                    <option>Max (Perro)</option>
                    <option>Luna (Gato)</option>
                    <option>Rocky (Perro)</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Fecha y Hora</label>
                <input type="datetime-local" class="form-control">
            </div>

            <div class="form-group">
                <label class="form-label">Servicio</label>
                <select class="form-control">
                    <option>Consulta general</option>
                    <option>Vacunación</option>
                    <option>Control postoperatorio</option>
                    <option>Estética</option>
                    <option>Urgencia</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Notas</label>
                <textarea class="form-control" rows="3"></textarea>
            </div>

            <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                <button type="button" class="btn" onclick="closeModal('nuevaCitaModal')" style="background: #E2E8F0;">Cancelar</button>
                <button type="submit" class="btn btn-primary">Agendar Cita</button>
            </div>
        </form>
    </div>
</div>

<script>
    // Funcionalidad básica para modales
    function openModal(modalId) {
        document.getElementById(modalId).style.display = 'flex';
    }

    function closeModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
    }

    // Cerrar modal al hacer clic fuera del contenido
    window.onclick = function(event) {
        const modals = document.getElementsByClassName('modal');
        for (let modal of modals) {
            if (event.target === modal) {
                modal.style.display = 'none';
            }
        }
    }
</script>