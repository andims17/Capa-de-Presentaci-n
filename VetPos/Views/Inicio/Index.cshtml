    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Hora</th>
                <th>Cliente</th>
                <th>Mascota</th>
                <th>Servicio</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>09:00 AM</td>
                <td>María González</td>
                <td>Max (Perro)</td>
                <td>Consulta general</td>
                <td><span class="badge badge-success">Confirmada</span></td>
                <td>
                    <button class="btn btn-primary" style="padding: 0.3rem 0.6rem; font-size: 0.8rem;">
                        <i class="fas fa-edit"></i>
                    </button>
                </td>
            </tr>
            <tr>
                <td>10:30 AM</td>
                <td>Carlos López</td>
                <td>Luna (Gato)</td>
                <td>Vacunación</td>
                <td><span class="badge badge-warning">Pendiente</span></td>
                <td>
                    <button class="btn btn-primary" style="padding: 0.3rem 0.6rem; font-size: 0.8rem;">
                        <i class="fas fa-edit"></i>
                    </button>
                </td>
            </tr>
            <tr>
                <td>02:00 PM</td>
                <td>Ana Martínez</td>
                <td>Rocky (Perro)</td>
                <td>Control postoperatorio</td>
                <td><span class="badge badge-success">Confirmada</span></td>
                <td>
                    <button class="btn btn-primary" style="padding: 0.3rem 0.6rem; font-size: 0.8rem;">
                        <i class="fas fa-edit"></i>
                    </button>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Alertas de Inventario</h2>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Stock Actual</th>
                <th>Stock Mínimo</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Antipulgas para perros grandes</td>
                <td>3</td>
                <td>10</td>
                <td><span class="badge badge-danger">Crítico</span></td>
                <td>
                    <button class="btn btn-primary" style="padding: 0.3rem 0.6rem; font-size: 0.8rem;">
                        <i class="fas fa-sync-alt"></i> Reabastecer
                    </button>
                </td>
            </tr>
            <tr>
                <td>Alimento para gatos adultos</td>
                <td>7</td>
                <td>15</td>
                <td><span class="badge badge-warning">Bajo</span></td>
                <td>
                    <button class="btn btn-primary" style="padding: 0.3rem 0.6rem; font-size: 0.8rem;">
                        <i class="fas fa-sync-alt"></i> Reabastecer
                    </button>
                </td>
            </tr>
            <tr>
                <td>Shampoo medicado</td>
                <td>5</td>
                <td>8</td>
                <td><span class="badge badge-warning">Bajo</span></td>
                <td>
                    <button class="btn btn-primary" style="padding: 0.3rem 0.6rem; font-size: 0.8rem;">
