@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Compartido/LayoutPrincipal.cshtml";

}

<style>
    /* Estilos específicos para el Dashboard */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .stat-card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
    }

    .stat-value {
        font-size: 2.5rem;
        font-weight: bold;
        margin: 0.5rem 0;
        color: #1E293B;
    }

    .stat-label {
        color: #64748B;
        font-size: 1rem;
    }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .bg-cyan {
        background-color: #E0F2FE;
        color: #0EA5E9;
    }

    .bg-green {
        background-color: #D1FAE5;
        color: #10B981;
    }

    .bg-orange {
        background-color: #FEF3C7;
        color: #F59E0B;
    }

    .bg-red {
        background-color: #FEE2E2;
        color: #EF4444;
    }

    .page-header {
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 2.5rem;
        font-weight: bold;
        color: #1E293B;
        margin-bottom: 0.5rem;
    }

    .page-subtitle {
        font-size: 1.5rem;
        color: #64748B;
        font-weight: 600;
    }

    .card {
        background: white;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 0.8rem;
        border-bottom: 1px solid #E2E8F0;
    }

    .card-title {
        font-size: 1.8rem;
        font-weight: bold;
        color: #1E293B;
    }

    .btn {
        padding: 0.6rem 1.2rem;
        border-radius: 6px;
        border: none;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .btn-primary {
        background-color: #0EA5E9;
        color: white;
    }

        .btn-primary:hover {
            background-color: #7DD3FC;
        }

    .table {
        width: 100%;
        border-collapse: collapse;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

        .table th, .table td {
            padding: 0.8rem 1rem;
            text-align: left;
            border-bottom: 1px solid #E2E8F0;
        }

        .table th {
            background-color: #F8FAFC;
            font-weight: 600;
            color: #1E293B;
        }

        .table tr:hover {
            background-color: #E0F2FE;
        }

    .badge {
        display: inline-block;
        padding: 0.3rem 0.6rem;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .badge-success {
        background-color: #10B981;
        color: white;
    }

    .badge-warning {
        background-color: #F59E0B;
        color: white;
    }

    .badge-danger {
        background-color: #EF4444;
        color: white;
    }

    .modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        align-items: center;
        justify-content: center;
    }

    .modal-content {
        background: white;
        border-radius: 10px;
        width: 90%;
        max-width: 600px;
        padding: 2rem;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #E2E8F0;
    }

    .modal-title {
        font-size: 1.8rem;
        font-weight: bold;
        color: #1E293B;
    }

    .close {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #64748B;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: #1E293B;
    }

    .form-control {
        width: 100%;
        padding: 0.8rem 1rem;
        border: 1px solid #E2E8F0;
        border-radius: 6px;
        font-size: 1rem;
        transition: border 0.3s;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

        .form-control:focus {
            outline: none;
            border-color: #0EA5E9;
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.2);
        }

    /* Estilos base */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background-color: #f5f7fa;
        color: #1E293B;
        line-height: 1.6;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Dashboard</h1>
    <p class="page-subtitle">Resumen general del sistema</p>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon bg-cyan">
            <i class="fas fa-cash-register"></i>
        </div>
        <div class="stat-value">$12,450</div>
        <div class="stat-label">Ventas del día</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon bg-green">
            <i class="fas fa-calendar-check"></i>
        </div>
        <div class="stat-value">8</div>
        <div class="stat-label">Citas hoy</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon bg-orange">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <div class="stat-value">5</div>
        <div class="stat-label">Productos bajos en stock</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon bg-red">
            <i class="fas fa-paw"></i>
        </div>
        <div class="stat-value">23</div>
        <div class="stat-label">Mascotas registradas</div>
    </div>
</div>

<div class="card">
    <div class="card-header">
