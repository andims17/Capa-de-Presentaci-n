@{
    ViewData["Title"] = "Historial de Ventas";
    Layout = "~/Views/Compartido/LayoutPrincipal.cshtml";
}

<style>
    .filters-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .sale-details {
        background: #F8FAFC;
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .sale-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }

    .sale-products {
        margin-top: 1rem;
    }

    .product-row {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        border-bottom: 1px solid #E2E8F0;
    }

        .product-row:last-child {
            border-bottom: none;
        }

    .sale-total {
        font-weight: bold;
        font-size: 1.1rem;
        color: #1E293B;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 2px solid #E2E8F0;
    }

    .status-completed {
        color: #10B981;
        font-weight: 600;
    }

    .status-pending {
        color: #F59E0B;
        font-weight: 600;
    }

    .status-cancelled {
        color: #EF4444;
        font-weight: 600;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Historial de Ventas</h1>
    <p class="page-subtitle">Registro completo de todas las ventas</p>
</div>

<div class="filters-row">
    <div class="form-group">
        <label class="form-label">Fecha Desde</label>
        <input type="date" class="form-control" value="2024-10-01">
    </div>

    <div class="form-group">
        <label class="form-label">Fecha Hasta</label>
        <input type="date" class="form-control" value="2024-10-15">
    </div>

    <div class="form-group">
        <label class="form-label">Estado</label>
        <select class="form-control">
            <option>Todos</option>
            <option>Completadas</option>
            <option>Pendientes</option>
            <option>Canceladas</option>
        </select>
    </div>

    <div class="form-group" style="display: flex; align-items: flex-end;">
        <button class="btn btn-primary">
            <i class="fas fa-filter"></i> Filtrar
        </button>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Todas las Ventas</h2>
        <div style="display: flex; gap: 1rem;">
            <button class="btn btn-success">
                <i class="fas fa-file-export"></i> Exportar
            </button>
            <button class="btn btn-primary">
                <i class="fas fa-print"></i> Imprimir
            </button>
        </div>
    </div>

    <!-- Venta 1 -->
    <div class="sale-details">
        <div class="sale-header">
            <div>
                <strong>Venta #V-001</strong>
                <div style="font-size: 0.9rem; color: #64748B;">15/10/2024 10:30</div>
            </div>
            <div style="text-align: right;">
                <div class="status-completed">Completada</div>
                <div style="font-weight: bold; font-size: 1.2rem;">$43.00</div>
            </div>
        </div>

        <div>
            <strong>Cliente:</strong> María González (CLI-001)
        </div>
        <div>
            <strong>Vendedor:</strong> Admin
        </div>
        <div>
            <strong>Método de pago:</strong> <span class="badge badge-success">Efectivo</span>
        </div>

        <div class="sale-products">
            <strong>Productos:</strong>
            <div class="product-row">
                <span>Antipulgas para perros grandes</span>
                <span>1 x $25.00 = $25.00</span>
            </div>
            <div class="product-row">
                <span>Alimento para perros 5kg</span>
                <span>1 x $18.00 = $18.00</span>
            </div>
        </div>

        <div class="sale-total" style="text-align: right;">
            Total: $43.00
        </div>
    </div>

    <!-- Venta 2 -->
    <div class="sale-details">
        <div class="sale-header">
            <div>
                <strong>Venta #V-002</strong>
                <div style="font-size: 0.9rem; color: #64748B;">15/10/2024 11:15</div>
            </div>
            <div style="text-align: right;">
                <div class="status-completed">Completada</div>
                <div style="font-weight: bold; font-size: 1.2rem;">$65.50</div>
            </div>
        </div>

        <div>
            <strong>Cliente:</strong> Carlos López (CLI-002)
        </div>
        <div>
            <strong>Vendedor:</strong> Admin
        </div>
        <div>
            <strong>Método de pago:</strong> <span class="badge badge-info">Tarjeta</span>
        </div>

        <div class="sale-products">
            <strong>Productos:</strong>
            <div class="product-row">
                <span>Vacuna triple felina</span>
                <span>1 x $35.00 = $35.00</span>
            </div>
            <div class="product-row">
                <span>Arena para gatos 4kg</span>
                <span>1 x $12.00 = $12.00</span>
            </div>
            <div class="product-row">
                <span>Juguete para gatos</span>
                <span>1 x $8.00 = $8.00</span>
            </div>
            <div class="product-row">
                <span>Shampoo medicado</span>
                <span>1 x $10.50 = $10.50</span>
            </div>
        </div>

        <div class="sale-total" style="text-align: right;">
            Total: $65.50
        </div>
    </div>

    <!-- Venta 3 -->
    <div class="sale-details">
        <div class="sale-header">
            <div>
                <strong>Venta #V-003</strong>
                <div style="font-size: 0.9rem; color: #64748B;">14/10/2024 14:20</div>
            </div>
            <div style="text-align: right;">
                <div class="status-completed">Completada</div>
                <div style="font-weight: bold; font-size: 1.2rem;">$28.50</div>
            </div>
        </div>

        <div>
            <strong>Cliente:</strong> Venta General
        </div>
        <div>
            <strong>Vendedor:</strong> Admin
        </div>
        <div>
            <strong>Método de pago:</strong> <span class="badge badge-success">Efectivo</span>
        </div>

        <div class="sale-products">
            <strong>Productos:</strong>
            <div class="product-row">
                <span>Correa para perros</span>
                <span>1 x $12.00 = $12.00</span>
            </div>
            <div class="product-row">
                <span>Alimento para gatos 2kg</span>
                <span>1 x $15.00 = $15.00</span>
            </div>
            <div class="product-row">
                <span>Shampoo medicado</span>
                <span>1 x $1.50 = $1.50</span>
            </div>
        </div>

        <div class="sale-total" style="text-align: right;">
            Total: $28.50
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Resumen de Ventas</h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; padding: 1.5rem;">
        <div style="text-align: center;">
            <div style="font-size: 2rem; font-weight: bold; color: #0EA5E9;">3</div>
            <div style="color: #64748B;">Ventas Totales</div>
        </div>
        <div style="text-align: center;">
            <div style="font-size: 2rem; font-weight: bold; color: #10B981;">$136.00</div>
            <div style="color: #64748B;">Ingresos Totales</div>
        </div>
        <div style="text-align: center;">
            <div style="font-size: 2rem; font-weight: bold; color: #F59E0B;">2</div>
            <div style="color: #64748B;">Clientes Atendidos</div>
        </div>
        <div style="text-align: center;">
            <div style="font-size: 2rem; font-weight: bold; color: #8B5CF6;">8</div>
            <div style="color: #64748B;">Productos Vendidos</div>
        </div>
    </div>
</div>