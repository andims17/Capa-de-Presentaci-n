                    <i class="fas fa-edit"></i> Editar
                </button>
            </div>
        </div>

        <!-- Compra 2 -->
        <div class="purchase-card">
            <div class="purchase-header">
                <div class="purchase-info">
                    <h3>Compra #C-002</h3>
                    <p>Factura: F-2024-002</p>
                </div>
                <div class="purchase-amount">
                    <div class="purchase-total">$320.50</div>
                    <div class="purchase-date">05/10/2024</div>
                </div>
            </div>
            <div class="purchase-details">
                <div class="detail-item">
                    <span class="detail-label">Proveedor:</span>
                    <span class="supplier-badge">VetProducts Corp</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Productos:</span>
                    <span class="detail-value">3 productos</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Estado:</span>
                    <span class="status-received">Recibida</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Registrado por:</span>
                    <span class="detail-value">Admin</span>
                </div>
            </div>
            <div class="purchase-actions">
                <button class="btn btn-primary btn-sm">
                    <i class="fas fa-eye"></i> Ver Detalles
                </button>
                <button class="btn btn-sm" style="background: #E2E8F0;">
                    <i class="fas fa-edit"></i> Editar
                </button>
            </div>
        </div>

        <!-- Compra 3 -->
        <div class="purchase-card">
            <div class="purchase-header">
                <div class="purchase-info">
                    <h3>Compra #C-003</h3>
                    <p>Factura: F-2024-003</p>
                </div>
                <div class="purchase-amount">
                    <div class="purchase-total">$180.00</div>
                    <div class="purchase-date">01/10/2024</div>
                </div>
            </div>
            <div class="purchase-details">
                <div class="detail-item">
                    <span class="detail-label">Proveedor:</span>
                    <span class="supplier-badge">AnimalCare Ltd</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Productos:</span>
                    <span class="detail-value">4 productos</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Estado:</span>
                    <span class="status-received">Recibida</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Registrado por:</span>
                    <span class="detail-value">Admin</span>
                </div>
            </div>
            <div class="purchase-actions">
                <button class="btn btn-primary btn-sm">
                    <i class="fas fa-eye"></i> Ver Detalles
                </button>
                <button class="btn btn-sm" style="background: #E2E8F0;">
                    <i class="fas fa-edit"></i> Editar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Resumen de Compras - Octubre 2024</h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; padding: 1.5rem;">
        <div style="text-align: center;">
            <div style="font-size: 2rem; font-weight: bold; color: #0EA5E9;">3</div>
            <div style="color: #64748B;">Compras Realizadas</div>
        </div>
        <div style="text-align: center;">
            <div style="font-size: 2rem; font-weight: bold; color: #10B981;">$950.50</div>
            <div style="color: #64748B;">Total Invertido</div>
        </div>
        <div style="text-align: center;">
            <div style="font-size: 2rem; font-weight: bold; color: #F59E0B;">12</div>
            <div style="color: #64748B;">Productos Comprados</div>
        </div>
        <div style="text-align: center;">
            <div style="font-size: 2rem; font-weight: bold; color: #8B5CF6;">3</div>
            <div style="color: #64748B;">Proveedores</div>
        </div>
    </div>
</div>

<!-- Modal para nueva compra -->
<div id="nuevaCompraModal" class="modal">
    <div class="modal-content" style="max-width: 800px;">
        <div class="modal-header">
            <h3 class="modal-title">Registrar Nueva Compra</h3>
            <button class="close" onclick="closeModal('nuevaCompraModal')">&times;</button>
        </div>

        <form>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label class="form-label">Proveedor</label>
                    <select class="form-control">
                        <option>Seleccionar proveedor</option>
                        <option>PetSupplies S.A.</option>
                        <option>VetProducts Corp</option>
                        <option>AnimalCare Ltd</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Número de Factura</label>
                    <input type="text" class="form-control" placeholder="Número de factura">
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                    <label class="form-label">Fecha de Compra</label>
                    <input type="date" class="form-control">
                </div>

                <div class="form-group">
                    <label class="form-label">Fecha de Recepción</label>
                    <input type="date" class="form-control">
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Productos de la Compra</label>
                <div style="border: 1px solid #E2E8F0; border-radius: 6px; padding: 1rem;">
                    <div style="display: grid; grid-template-columns: 2fr 1fr 1fr 1fr auto; gap: 0.5rem; margin-bottom: 1rem; font-weight: 600; color: #64748B;">
                        <div>Producto</div>
                        <div>Cantidad</div>
                        <div>Precio Unit.</div>
                        <div>Subtotal</div>
                        <div></div>
                    </div>

                    <div id="productosCompra">
                        <!-- Productos se agregarán dinámicamente -->
                    </div>

                    <button type="button" class="btn" style="background: #E2E8F0; width: 100%;" onclick="agregarProductoCompra()">
                        <i class="fas fa-plus"></i> Agregar Producto
                    </button>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem;">
                <div class="form-group">
                    <label class="form-label">Subtotal</label>
                    <input type="text" class="form-control" value="$0.00" readonly>
                </div>

                <div class="form-group">
                    <label class="form-label">Total</label>
                    <input type="text" class="form-control" value="$0.00" readonly>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Observaciones</label>
                <textarea class="form-control" rows="3" placeholder="Observaciones de la compra..."></textarea>
            </div>

            <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                <button type="button" class="btn" onclick="closeModal('nuevaCompraModal')" style="background: #E2E8F0;">Cancelar</button>
                <button type="submit" class="btn btn-primary">Registrar Compra</button>
            </div>
        </form>
    </div>
</div>

<script>
    let productoCount = 0;

    function agregarProductoCompra() {
        productoCount++;
        const productosContainer = document.getElementById('productosCompra');

        const productoHTML = `
            <div style="display: grid; grid-template-columns: 2fr 1fr 1fr 1fr auto; gap: 0.5rem; margin-bottom: 0.5rem; align-items: center;">
                <select class="form-control" style="font-size: 0.9rem;">
                    <option>Seleccionar producto</option>
                    <option>Antipulgas para perros grandes</option>
                    <option>Alimento para perros adulto 5kg</option>
                    <option>Arena para gatos absorbente 4kg</option>
                    <option>Vacuna triple felina</option>
                </select>
                <input type="number" class="form-control" value="1" min="1" style="font-size: 0.9rem;">
                <input type="number" class="form-control" value="0.00" step="0.01" style="font-size: 0.9rem;">
                <input type="text" class="form-control" value="$0.00" readonly style="font-size: 0.9rem;">
                <button type="button" class="btn-danger" onclick="removerProducto(this)">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        `;

        productosContainer.insertAdjacentHTML('beforeend', productoHTML);
    }

    function removerProducto(button) {
        button.closest('div').remove();
    }
</script>