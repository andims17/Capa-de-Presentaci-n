@{
    ViewData["Title"] = "Reportes y Estadísticas";
}

<div class="page-header">
    <h1 class="page-title">Reportes y Estadísticas</h1>
    <p class="page-subtitle">Análisis y reportes del sistema</p>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Filtros de Reportes</h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
        <div class="form-group">
            <label class="form-label">Tipo de Reporte</label>
            <select class="form-control" id="tipoReporte">
                <option value="ventas">Ventas</option>
                <option value="citas">Citas</option>
                <option value="inventario">Inventario</option>
                <option value="clientes">Clientes</option>
            </select>
        </div>

        <div class="form-group">
            <label class="form-label">Fecha Desde</label>
            <input type="date" class="form-control" id="fechaDesde">
        </div>

        <div class="form-group">
            <label class="form-label">Fecha Hasta</label>
            <input type="date" class="form-control" id="fechaHasta">
        </div>

        <div class="form-group" style="display: flex; align-items: flex-end;">
            <button class="btn btn-primary" onclick="generarReporte()">
                <i class="fas fa-chart-bar"></i> Generar Reporte
            </button>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Resumen de Ventas - Octubre 2024</h2>
        <button class="btn btn-success" onclick="exportarReporte()">
            <i class="fas fa-file-export"></i> Exportar
        </button>
    </div>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem;">
        <!-- Gráfico de ventas -->
        <div>
            <h3 style="margin-bottom: 1rem;">Ventas por Día</h3>
            <div style="background: var(--gray-light); border-radius: 8px; padding: 2rem; height: 300px; display: flex; align-items: flex-end; gap: 1rem;">
                <!-- Barras del gráfico -->
                <div style="flex: 1; display: flex; flex-direction: column; align-items: center;">
                    <div style="background: var(--primary-dark); width: 30px; height: 150px; border-radius: 4px;"></div>
                    <span style="margin-top: 0.5rem;">Lun</span>
                </div>
                <div style="flex: 1; display: flex; flex-direction: column; align-items: center;">
                    <div style="background: var(--primary-dark); width: 30px; height: 200px; border-radius: 4px;"></div>
                    <span style="margin-top: 0.5rem;">Mar</span>
                </div>
                <div style="flex: 1; display: flex; flex-direction: column; align-items: center;">
                    <div style="background: var(--primary-dark); width: 30px; height: 180px; border-radius: 4px;"></div>
                    <span style="margin-top: 0.5rem;">Mié</span>
                </div>
                <div style="flex: 1; display: flex; flex-direction: column; align-items: center;">
                    <div style="background: var(--primary-dark); width: 30px; height: 220px; border-radius: 4px;"></div>
                    <span style="margin-top: 0.5rem;">Jue</span>
                </div>
                <div style="flex: 1; display: flex; flex-direction: column; align-items: center;">
                    <div style="background: var(--primary-dark); width: 30px; height: 250px; border-radius: 4px;"></div>
                    <span style="margin-top: 0.5rem;">Vie</span>
                </div>
                <div style="flex: 1; display: flex; flex-direction: column; align-items: center;">
                    <div style="background: var(--primary-dark); width: 30px; height: 120px; border-radius: 4px;"></div>
                    <span style="margin-top: 0.5rem;">Sáb</span>
                </div>
            </div>
        </div>

        <!-- Estadísticas rápidas -->
        <div>
            <h3 style="margin-bottom: 1rem;">Estadísticas Rápidas</h3>
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <div style="background: var(--primary-light); padding: 1rem; border-radius: 8px;">
                    <div style="font-size: 1.5rem; font-weight: bold; color: var(--primary-dark);">$8,450</div>
                    <div style="color: var(--gray-dark);">Ventas Totales</div>
                </div>

                <div style="background: #D1FAE5; padding: 1rem; border-radius: 8px;">
                    <div style="font-size: 1.5rem; font-weight: bold; color: var(--success);">42</div>
                    <div style="color: var(--gray-dark);">Ventas Realizadas</div>
                </div>

                <div style="background: #FEF3C7; padding: 1rem; border-radius: 8px;">
                    <div style="font-size: 1.5rem; font-weight: bold; color: var(--warning);">18</div>
                    <div style="color: var(--gray-dark);">Citas Atendidas</div>
                </div>

                <div style="background: #FEE2E2; padding: 1rem; border-radius: 8px;">
                    <div style="font-size: 1.5rem; font-weight: bold; color: var(--danger);">5</div>
                    <div style="color: var(--gray-dark);">Productos Bajos en Stock</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Productos Más Vendidos</h2>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Categoría</th>
                <th>Unidades Vendidas</th>
                <th>Ingresos</th>
                <th>Tendencia</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Antipulgas para perros grandes</td>
                <td>Medicamento</td>
                <td>28</td>
                <td>$700.00</td>
                <td><span style="color: var(--success);">↗ 15%</span></td>
            </tr>
            <tr>
                <td>Alimento para perros adulto 5kg</td>
                <td>Alimento</td>
                <td>25</td>
                <td>$462.50</td>
                <td><span style="color: var(--success);">↗ 8%</span></td>
            </tr>
            <tr>
                <td>Arena para gatos absorbente 4kg</td>
                <td>Accesorio</td>
                <td>22</td>
                <td>$264.00</td>
                <td><span style="color: var(--success);">↗ 12%</span></td>
            </tr>
            <tr>
                <td>Vacuna triple felina</td>
                <td>Medicamento</td>
                <td>18</td>
                <td>$630.00</td>
                <td><span style="color: var(--warning);">→ 0%</span></td>
            </tr>
            <tr>
                <td>Shampoo medicado para perros</td>
                <td>Higiene</td>
                <td>15</td>
                <td>$150.00</td>
                <td><span style="color: var(--danger);">↘ 5%</span></td>
            </tr>
        </tbody>
    </table>
</div>

<script>
    function generarReporte() {
        const tipoReporte = document.getElementById('tipoReporte').value;
        const fechaDesde = document.getElementById('fechaDesde').value;
        const fechaHasta = document.getElementById('fechaHasta').value;

        alert(`Generando reporte de ${tipoReporte} desde ${fechaDesde} hasta ${fechaHasta}`);
        // Aquí iría la lógica para generar el reporte con los filtros
    }

    function exportarReporte() {
        alert('Exportando reporte a Excel...');
        // Aquí iría la lógica para exportar el reporte
    }
</script>