<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VetPost</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        /* TODOS LOS ESTILOS DEL LAYOUT */
        :root {
            --primary-cyan: #7DD3FC;
            --primary-dark: #0EA5E9;
            --primary-light: #E0F2FE;
            --success: #10B981;
            --warning: #F59E0B;
            --danger: #EF4444;
            --gray-light: #F8FAFC;
            --gray-medium: #E2E8F0;
            --gray-dark: #64748B;
            --text-dark: #1E293B;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f5f7fa;
            color: var(--text-dark);
            line-height: 1.6;
        }

        .app-container {
            display: flex;
            min-height: 100vh;
        }

        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .header {
            background: linear-gradient(135deg, var(--primary-dark), var(--primary-cyan));
            color: white;
            padding: 1.5rem 2rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .logo {
            height: 60px;
            width: auto;
        }

        .app-title {
            font-size: 2.5rem;
            font-weight: bold;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary-dark);
            font-weight: bold;
        }

        .content-wrapper {
            display: flex;
            flex: 1;
        }

        .sidebar {
            width: 280px;
            background-color: white;
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.05);
            padding: 1.5rem 0;
            display: flex;
            flex-direction: column;
        }

        .nav-section {
            margin-bottom: 1.5rem;
        }

        .nav-header {
            padding: 0.8rem 1.5rem;
            color: #64748B;
            font-weight: 600;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .nav-header i {
                width: 16px;
                text-align: center;
            }

        .nav-item {
            padding: 0.8rem 1.5rem 0.8rem 2.5rem;
            display: flex;
            align-items: center;
            gap: 0.8rem;
            color: #64748B;
            text-decoration: none;
            transition: all 0.3s;
            border-left: 4px solid transparent;
            font-size: 0.95rem;
        }

            .nav-item:hover {
                background-color: #E0F2FE;
                color: #0EA5E9;
                border-left-color: #0EA5E9;
            }

            .nav-item.active {
                background-color: #E0F2FE;
                color: #0EA5E9;
                border-left-color: #0EA5E9;
                font-weight: 600;
            }

            .nav-item i {
                width: 20px;
                text-align: center;
                font-size: 1rem;
            }

        .nav-footer {
            margin-top: auto;
            border-top: 1px solid #E2E8F0;
            padding-top: 1rem;
        }

        .nav-item.logout {
            color: #EF4444;
        }

            .nav-item.logout:hover {
                background-color: #FEE2E2;
                color: #DC2626;
                border-left-color: #EF4444;
            }

        .content-area {
            flex: 1;
            padding: 2rem;
            overflow-y: auto;
        }

        .page-header {
            margin-bottom: 2rem;
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: bold;
            color: var(--text-dark);
            margin-bottom: 0.5rem;
        }

        .page-subtitle {
            font-size: 1.5rem;
            color: var(--gray-dark);
            font-weight: 600;
        }

        /* ... resto de tus estilos ... */
    </style>
</head>
<body>
    <div class="app-container">
        <div class="main-content">
            <header class="header">
                <div class="logo-container">
                    <img src="~/img/logo.png" alt="VetPost Logo" class="logo" />
                    <h1 class="app-title">VetPost</h1>
                </div>
                <div class="user-info">
                    <span>Bienvenido, Administrador</span>
                    <div class="user-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                </div>
            </header>

            <div class="content-wrapper">
                <!-- BARRA DE NAVEGACIÓN -->
                <nav class="sidebar">
                    <div class="nav-section">
                        <div class="nav-header">
                            <i class="fas fa-paw"></i>
                            <span>Principal</span>
                        </div>
                        <a href="/Inicio/Index" class="nav-item">
                            <i class="fas fa-tachometer-alt"></i>
                            <span>Dashboard</span>
                        </a>
                    </div>

                    <div class="nav-section">
                        <div class="nav-header">
                            <i class="fas fa-shopping-cart"></i>
                            <span>Ventas</span>
                        </div>
                        <a href="/Ventas/Index" class="nav-item">
                            <i class="fas fa-cash-register"></i>
                            <span>Punto de Venta</span>
                        </a>
                        <a href="/Ventas/Historial" class="nav-item">
                            <i class="fas fa-history"></i>
                            <span>Historial Ventas</span>
                        </a>
                    </div>

                    <div class="nav-section">
                        <div class="nav-header">
                            <i class="fas fa-calendar"></i>
                            <span>Citas</span>
                        </div>
                        <a href="/Citas/Index" class="nav-item">
                            <i class="fas fa-calendar-alt"></i>
                            <span>Gestión de Citas</span>
                        </a>
                        <a href="/Citas/Calendario" class="nav-item">
                            <i class="fas fa-calendar-day"></i>
                            <span>Calendario</span>
                        </a>
                    </div>

                    <div class="nav-section">
                        <div class="nav-header">
                            <i class="fas fa-users"></i>
                            <span>Clientes</span>
                        </div>
                        <a href="/Clientes/Index" class="nav-item">
                            <i class="fas fa-user-friends"></i>
                            <span>Gestión de Clientes</span>
                        </a>
                        <a href="/Mascotas/Index" class="nav-item">
                            <i class="fas fa-paw"></i>
                            <span>Mascotas</span>
                        </a>
                    </div>

                    <div class="nav-section">
                        <div class="nav-header">
                            <i class="fas fa-boxes"></i>
                            <span>Inventario</span>
                        </div>
                        <a href="/Inventario/Index" class="nav-item">
                            <i class="fas fa-box-open"></i>
                            <span>Gestión Inventario</span>
                        </a>
                        <a href="/Inventario/Compras" class="nav-item">
                            <i class="fas fa-shopping-cart"></i>
                            <span>Compras</span>
                        </a>
                    </div>

                    <div class="nav-section">
                        <div class="nav-header">
                            <i class="fas fa-chart-bar"></i>
                            <span>Reportes</span>
                        </div>
                        <a href="/Reportes/Index" class="nav-item">
                            <i class="fas fa-chart-line"></i>
                            <span>Reportes y Estadísticas</span>
                        </a>
                    </div>

                    <div class="nav-section">
                        <div class="nav-header">
                            <i class="fas fa-cog"></i>
                            <span>Administración</span>
                        </div>
                        <a href="/Usuarios/Index" class="nav-item">
                            <i class="fas fa-user-cog"></i>
                            <span>Usuarios</span>
                        </a>
                    </div>

                    <div class="nav-section nav-footer">
                        <a href="/Cuenta/Logout" class="nav-item logout">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Cerrar Sesión</span>
                        </a>
                    </div>
                </nav>

                <main class="content-area">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script>
        // Funcionalidad para resaltar elemento de navegación activo
        document.addEventListener('DOMContentLoaded', function() {
            const currentPath = window.location.pathname;
            const navItems = document.querySelectorAll('.nav-item');

            navItems.forEach(item => {
                if (item.getAttribute('href') === currentPath) {
                    item.classList.add('active');
                }
            });

            // Funcionalidad básica para modales
            window.openModal = function(modalId) {
                document.getElementById(modalId).style.display = 'flex';
            }

            window.closeModal = function(modalId) {
                document.getElementById(modalId).style.display = 'none';
            }

            // Cerrar modal al hacer clic fuera del contenido
            window.onclick = function(event) {
                const modals = document.getElementsByClassName('modal');
                for (let modal of modals) {
                    if (event.target === modal) {
                        modal.style.display = 'none';
                    }
                }
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>