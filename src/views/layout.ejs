<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || 'VetPost' %></title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/clientes.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/styles.css">

    <!-- Script crítico: aplicar tema ANTES de renderizar para evitar flash -->
    <script>
        (function() {
            try {
                // Aplicar tema inmediatamente, sin esperar DOMContentLoaded
                // Esto previene el "flash of light content" cuando cambias de página
                const savedTheme = localStorage.getItem('theme');
                const html = document.documentElement;
                
                // Si hay tema guardado, aplicarlo inmediatamente
                if (savedTheme === 'dark') {
                    html.setAttribute('data-theme', 'dark');
                } else if (!savedTheme) {
                    // Si no hay tema guardado, detectar preferencia del sistema
                    // Solo si matchMedia está disponible (navegadores modernos)
                    if (window.matchMedia) {
                        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                        if (prefersDark) {
                            html.setAttribute('data-theme', 'dark');
                            localStorage.setItem('theme', 'dark');
                        }
                    }
                }
            } catch (e) {
                // Si hay error (por ejemplo, localStorage bloqueado), continuar sin tema
                console.warn('No se pudo aplicar el tema:', e);
            }
        })();
    </script>

    <style>
        :root {
            /* Colores primarios */
            --primary-cyan: #7DD3FC;
            --primary-dark: #0EA5E9;
            --primary-light: #E0F2FE;
            --success: #10B981;
            --warning: #F59E0B;
            --danger: #EF4444;
            
            /* Colores de fondo y texto (tema claro) */
            --bg-primary: #f5f7fa;
            --bg-secondary: #ffffff;
            --bg-tertiary: #F8FAFC;
            --text-primary: #1E293B;
            --text-secondary: #64748B;
            --border-color: #E2E8F0;
            
            /* Colores legacy (para compatibilidad) */
            --gray-light: #F8FAFC;
            --gray-medium: #E2E8F0;
            --gray-dark: #64748B;
            --text-dark: #1E293B;
        }

        /* Tema oscuro */
        [data-theme="dark"] {
            --primary-cyan: #7DD3FC;
            --primary-dark: #0EA5E9;
            --primary-light: #1E3A5F;
            --success: #10B981;
            --warning: #F59E0B;
            --danger: #EF4444;
            
            /* Colores invertidos para dark mode */
            --bg-primary: #0F172A;
            --bg-secondary: #1E293B;
            --bg-tertiary: #334155;
            --text-primary: #F1F5F9;
            --text-secondary: #94A3B8;
            --border-color: #334155;
            
            /* Colores legacy actualizados */
            --gray-light: #1E293B;
            --gray-medium: #334155;
            --gray-dark: #94A3B8;
            --text-dark: #F1F5F9;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
        }

        body {
            background-color: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.6;
        }

        .app-container {
            display: flex;
            min-height: 100vh;
        }

        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .header {
            background: linear-gradient(135deg, var(--primary-dark), var(--primary-cyan));
            color: white;
            padding: 1.5rem 2rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .logo {
            height: 48px;
            width: auto;
            object-fit: contain;
        }

        .app-title {
            font-size: 2.5rem;
            font-weight: bold;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary-dark);
            font-weight: bold;
        }

        [data-theme="dark"] .user-avatar {
            background-color: rgba(255, 255, 255, 0.2);
            color: var(--primary-cyan);
        }

        /* Botón de toggle dark mode */
        .theme-toggle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: none;
            background-color: rgba(255, 255, 255, 0.2);
            color: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            font-size: 1.2rem;
            margin-right: 0.5rem;
        }

        .theme-toggle:hover {
            background-color: rgba(255, 255, 255, 0.3);
            transform: rotate(15deg) scale(1.1);
        }

        [data-theme="dark"] .theme-toggle {
            background-color: rgba(255, 255, 255, 0.1);
        }

        [data-theme="dark"] .theme-toggle:hover {
            background-color: rgba(255, 255, 255, 0.2);
        }

        .content-wrapper {
            display: flex;
            flex: 1;
        }

        .sidebar {
            width: 280px;
            background-color: var(--bg-secondary);
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.05);
            padding: 1.5rem 0;
            display: flex;
            flex-direction: column;
        }

        [data-theme="dark"] .sidebar {
            box-shadow: 2px 0 5px rgba(0, 0, 0, 0.3);
        }

        .nav-section {
            margin-bottom: 1.5rem;
        }

        .nav-header {
            padding: 0.8rem 1.5rem;
            color: var(--text-secondary);
            font-weight: 600;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .nav-header i {
            width: 16px;
            text-align: center;
        }

        .nav-item {
            padding: 0.8rem 1.5rem 0.8rem 2.5rem;
            display: flex;
            align-items: center;
            gap: 0.8rem;
            color: var(--text-secondary);
            text-decoration: none;
            transition: all 0.3s;
            border-left: 4px solid transparent;
            font-size: 0.95rem;
        }

        .nav-item:hover {
            background-color: var(--primary-light);
            color: var(--primary-dark);
            border-left-color: var(--primary-dark);
        }

        [data-theme="dark"] .nav-item:hover {
            background-color: rgba(14, 165, 233, 0.1);
        }

        .nav-item.active {
            background-color: var(--primary-light);
            color: var(--primary-dark);
            border-left-color: var(--primary-dark);
            font-weight: 600;
        }

        [data-theme="dark"] .nav-item.active {
            background-color: rgba(14, 165, 233, 0.15);
        }

        .nav-item i {
            width: 20px;
            text-align: center;
            font-size: 1rem;
        }

        .nav-footer {
            margin-top: auto;
            border-top: 1px solid var(--border-color);
            padding-top: 1rem;
        }

        .nav-item.logout {
            color: var(--danger, #EF4444);
        }

        .nav-item.logout:hover {
            background-color: rgba(239, 68, 68, 0.1);
            color: #DC2626;
            border-left-color: var(--danger, #EF4444);
        }

        [data-theme="dark"] .nav-item.logout:hover {
            background-color: rgba(239, 68, 68, 0.2);
        }

        .content-area {
            flex: 1;
            padding: 2rem;
            overflow-y: auto;
            background-color: var(--bg-primary);
        }

        .page-header {
            margin-bottom: 2rem;
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: bold;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
        }

        .page-subtitle {
            font-size: 1.5rem;
            color: var(--text-secondary);
            font-weight: 600;
        }
    </style>
</head>

<body>
    <div class="app-container">
        <div class="main-content">
            <header class="header">
                <div class="logo-container">
                    <img src="/img/animales-logo.jpeg" alt="Animales Fantásticos" class="logo" />
                    <h1 class="app-title">VetPost</h1>
                </div>
                <div class="user-info">
                    <span>Bienvenido, Administrador</span>
                    
                    <!-- Botón de toggle dark mode -->
                    <button id="themeToggle" class="theme-toggle" title="Cambiar tema">
                        <i class="fas fa-sun" id="themeIcon"></i>
                    </button>
                    
                    <div class="user-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                </div>
            </header>

            <div class="content-wrapper">
                <!-- SIDEBAR / MENÚ -->
                <nav class="sidebar">
                    <div class="nav-section">
                        <div class="nav-header">
                            <i class="fas fa-paw"></i>
                            <span>Principal</span>
                        </div>
                        <a href="/inicio" class="nav-item">
                            <i class="fas fa-tachometer-alt"></i>
                            <span>Dashboard</span>
                        </a>
                    </div>

                    <div class="nav-section">
                        <div class="nav-header">
                            <i class="fas fa-shopping-cart"></i>
                            <span>Ventas</span>
                        </div>
                        <a href="/ventas" class="nav-item">
                            <i class="fas fa-cash-register"></i>
                            <span>Punto de Venta</span>
                        </a>
                        <a href="/ventas/historial" class="nav-item">
                            <i class="fas fa-history"></i>
                            <span>Historial Ventas</span>
                        </a>
                    </div>

                    <div class="nav-section">
                        <div class="nav-header">
                            <i class="fas fa-calendar"></i>
                            <span>Citas</span>
                        </div>
                        <a href="/citas" class="nav-item">
                            <i class="fas fa-calendar-alt"></i>
                            <span>Gestión de Citas</span>
                        </a>
                        <a href="/citas/calendario" class="nav-item">
                            <i class="fas fa-calendar-day"></i>
                            <span>Calendario</span>
                        </a>
                    </div>

                    <div class="nav-section">
                        <div class="nav-header">
                            <i class="fas fa-users"></i>
                            <span>Clientes</span>
                        </div>
                        <a href="/clientes" class="nav-item">
                            <i class="fas fa-user-friends"></i>
                            <span>Gestión de Clientes</span>
                        </a>
                        <a href="/mascota" class="nav-item">
                            <i class="fas fa-paw"></i>
                            <span>Mascotas</span>
                        </a>
                    </div>

                    <div class="nav-section">
                        <div class="nav-header">
                            <i class="fas fa-boxes"></i>
                            <span>Inventario</span>
                        </div>
                        <a href="/inventario" class="nav-item">
                            <i class="fas fa-box-open"></i>
                            <span>Gestión Inventario</span>
                        </a>
                        <a href="/inventario/compras" class="nav-item">
                            <i class="fas fa-shopping-cart"></i>
                            <span>Compras</span>
                        </a>
                        <a href="/proveedores" class="nav-item">
                            <i class="fas fa-truck"></i>
                            <span>Proveedores</span>
                        </a>
                    </div>

                    <div class="nav-section">
                        <div class="nav-header">
                            <i class="fas fa-chart-bar"></i>
                            <span>Reportes</span>
                        </div>
                        <a href="/reportes" class="nav-item">
                            <i class="fas fa-chart-line"></i>
                            <span>Reportes y Estadísticas</span>
                        </a>
                    </div>

                    <div class="nav-section">
                        <div class="nav-header">
                            <i class="fas fa-cog"></i>
                            <span>Administración</span>
                        </div>
                        <a href="/usuarios" class="nav-item">
                            <i class="fas fa-user-cog"></i>
                            <span>Usuarios</span>
                        </a>
                    </div>

                    <div class="nav-section nav-footer">
                        <a href="/cuenta/logout" class="nav-item logout">
                            <i class="fas fa-sign-out-alt"></i>
                            <span>Cerrar Sesión</span>
                        </a>
                    </div>
                </nav>

                <!-- CONTENIDO PRINCIPAL -->
                <main class="content-area">
                    <%- body %>
                </main>
            </div>
        </div>
    </div>

    <script src="/js/main.js"></script>
    <script src="/js/theme-toggle.js"></script>

    <script>
        // Resaltar elemento activo
        document.addEventListener('DOMContentLoaded', function () {
            const currentPath = window.location.pathname;
            const navItems = document.querySelectorAll('.nav-item');

            navItems.forEach(item => {
                if (item.getAttribute('href') === currentPath) {
                    item.classList.add('active');
                }
            });
        });
    </script>
</body>
</html>
