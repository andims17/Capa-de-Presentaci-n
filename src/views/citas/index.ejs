<div class="page-header">
  <h1 class="page-title">Gestión de Citas</h1>
  <p class="page-subtitle">Administra las citas de la veterinaria</p>
</div>

<div class="filters-section">
  <div class="filter-group">
    <label class="filter-label">Fecha</label>
    <input type="date" class="form-control" style="width: 200px;">
  </div>
  <div class="filter-group">
    <label class="filter-label">Estado</label>
    <select class="form-control" style="width: 150px;">
      <option>Todas</option>
      <option>Confirmadas</option>
      <option>Pendientes</option>
      <option>Canceladas</option>
    </select>
  </div>
  <div class="filter-group">
    <label class="filter-label">Veterinario</label>
    <select class="form-control" style="width: 180px;">
      <option>Todos</option>
      <option>Dr. Carlos Rodríguez</option>
      <option>Dra. Ana García</option>
    </select>
  </div>
</div>

<div class="citas-container">
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Citas de Hoy</h2>
      <span class="badge badge-info">3 citas</span>
    </div>

    <div class="citas-list">
      <div class="cita-item">
        <div class="cita-hora">09:00 AM</div>
        <div class="cita-info">
          <div class="cita-cliente">María González</div>
          <div class="cita-mascota">Max (Perro - Labrador)</div>
          <div class="cita-servicio">Consulta general</div>
        </div>
        <div class="cita-estado">
          <span class="badge badge-success">Confirmada</span>
        </div>
      </div>

      <div class="cita-item">
        <div class="cita-hora">10:30 AM</div>
        <div class="cita-info">
          <div class="cita-cliente">Carlos López</div>
          <div class="cita-mascota">Luna (Gato - Persa)</div>
          <div class="cita-servicio">Vacunación anual</div>
        </div>
        <div class="cita-estado">
          <span class="badge badge-warning">Pendiente</span>
        </div>
      </div>

      <div class="cita-item">
        <div class="cita-hora">02:00 PM</div>
        <div class="cita-info">
          <div class="cita-cliente">Ana Martínez</div>
          <div class="cita-mascota">Rocky (Perro - Pastor Alemán)</div>
          <div class="cita-servicio">Control postoperatorio</div>
        </div>
        <div class="cita-estado">
          <span class="badge badge-success">Confirmada</span>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Próximas Citas</h2>
      <span class="badge badge-info">2 citas</span>
    </div>

    <div class="citas-list">
      <div class="cita-item">
        <div class="cita-fecha">Mañana</div>
        <div class="cita-info">
          <div class="cita-cliente">Roberto Sánchez</div>
          <div class="cita-mascota">Mimi (Gato - Siames)</div>
          <div class="cita-servicio">Desparasitación - 11:00 AM</div>
        </div>
      </div>

      <div class="cita-item">
        <div class="cita-fecha">15 Oct</div>
        <div class="cita-info">
          <div class="cita-cliente">Laura Díaz</div>
          <div class="cita-mascota">Thor (Perro - Husky)</div>
          <div class="cita-servicio">Corte de uñas y baño - 03:30 PM</div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">Todas las Citas</h2>
    <button class="btn btn-primary" onclick="openModal('nuevaCitaModal')">
      <i class="fas fa-plus"></i> Nueva Cita
    </button>
  </div>

  <table class="table">
    <thead>
      <tr>
        <th>Fecha</th>
        <th>Cliente</th>
        <th>Mascota</th>
        <th>Servicio</th>
        <th>Veterinario</th>
        <th>Estado</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>15/10/2024 09:00</td>
        <td>María González</td>
        <td>Max (Perro)</td>
        <td>Consulta general</td>
        <td>Dr. Carlos Rodríguez</td>
        <td><span class="badge badge-success">Confirmada</span></td>
        <td>
          <button class="btn btn-primary" style="padding:0.3rem 0.6rem;font-size:0.8rem;">
            <i class="fas fa-edit"></i>
          </button>
          <button class="btn btn-danger" style="padding:0.3rem 0.6rem;font-size:0.8rem;">
            <i class="fas fa-trash"></i>
          </button>
        </td>
      </tr>
      <tr>
        <td>15/10/2024 10:30</td>
        <td>Carlos López</td>
        <td>Luna (Gato)</td>
        <td>Vacunación anual</td>
        <td>Dra. Ana García</td>
        <td><span class="badge badge-warning">Pendiente</span></td>
        <td>
          <button class="btn btn-primary" style="padding:0.3rem 0.6rem;font-size:0.8rem;">
            <i class="fas fa-edit"></i>
          </button>
          <button class="btn btn-danger" style="padding:0.3rem 0.6rem;font-size:0.8rem;">
            <i class="fas fa-trash"></i>
          </button>
        </td>
      </tr>
    </tbody>
  </table>
</div>

<div id="nuevaCitaModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h3 class="modal-title">Agendar Nueva Cita</h3>
      <button class="close" onclick="closeModal('nuevaCitaModal')">&times;</button>
    </div>

    <form>
      <div class="form-group">
        <label class="form-label">Cliente</label>
        <select class="form-control">
          <option>Seleccionar cliente</option>
          <option>María González</option>
          <option>Carlos López</option>
          <option>Ana Martínez</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Mascota</label>
        <select class="form-control">
          <option>Seleccionar mascota</option>
          <option>Max (Perro - Labrador)</option>
          <option>Luna (Gato - Persa)</option>
          <option>Rocky (Perro - Pastor Alemán)</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Fecha y Hora</label>
        <input type="datetime-local" class="form-control">
      </div>

      <div class="form-group">
        <label class="form-label">Servicio</label>
        <select class="form-control">
          <option>Consulta general</option>
          <option>Vacunación</option>
          <option>Desparasitación</option>
          <option>Control postoperatorio</option>
          <option>Estética</option>
          <option>Urgencia</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Veterinario</label>
        <select class="form-control">
          <option>Dr. Carlos Rodríguez</option>
          <option>Dra. Ana García</option>
          <option>Dr. Miguel Torres</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Notas</label>
        <textarea class="form-control" rows="3" placeholder="Observaciones adicionales..."></textarea>
      </div>

      <div style="display:flex;gap:1rem;justify-content:flex-end;">
        <button type="button" class="btn btn-plain" onclick="closeModal('nuevaCitaModal')">
          Cancelar
        </button>
        <button type="submit" class="btn btn-primary">Agendar Cita</button>
      </div>
    </form>
  </div>
</div>
