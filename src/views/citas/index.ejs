<div class="page-header">
    <h1 class="page-title">Gestión de Citas</h1>
    <p class="page-subtitle">Registro y edición de citas de grooming</p>
</div>

<!-- Modal de Error -->
<div id="errorModal" class="modal" style="display:none;">
    <div class="modal-content card" style="max-width: 420px; margin: auto;">
        <div class="modal-header" style="background:#fee2e2; border-bottom: 1px solid #fca5a5;">
            <h3 class="modal-title" style="color:#991b1b; display:flex; align-items:center; gap:.5rem;">
                <i class="fas fa-circle-exclamation"></i> No se pudo guardar
            </h3>
            <button class="close" onclick="closeModal('errorModal')">&times;</button>
        </div>
        <div class="modal-body" style="padding: 1.5rem;">
            <p id="errorModalMsg" style="margin:0; color:#374151; font-size:.97rem; line-height:1.5;"></p>
        </div>
        <div style="display:flex; justify-content:flex-end; padding: 1rem 1.5rem;">
            <button class="btn btn-primary" onclick="closeModal('errorModal')">Entendido</button>
        </div>
    </div>
</div>

<!-- Filtro -->
<div class="card mb-4">
    <div class="card-header">
        <h2 class="card-title">Filtros</h2>
    </div>
    <div class="card-body">
        <form method="GET" class="row g-3">
            <div class="col-md-4">
                <label>Fecha</label>
                <input type="date" name="fecha" value="<%= fecha || '' %>" class="form-control">
            </div>
            <div class="col-md-4">
                <label>Cliente</label>
                <select name="clienteId" class="form-control">
                    <option value="">Todos</option>
                    <% (clientes || []).forEach(cl => { %>
                        <option value="<%= cl.Id %>" <%= (clienteId == cl.Id) ? 'selected' : '' %>>
                            <%= cl.NombreCompleto %>
                        </option>
                    <% }) %>
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Filtrar</button>
            </div>
        </form>
    </div>
</div>

<!-- Listado -->
<div class="card">
    <div class="card-header">
        <h2 class="card-title">Citas Registradas</h2>
    </div>
    <div class="card-body">
        <% if (!citas || citas.length === 0) { %>
            <p class="text-center text-muted">No hay citas registradas.</p>
        <% } else { %>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Hora</th>
                            <th>Mascota</th>
                            <th>Cliente</th>
                            <th>Servicio</th>
                            <th>Estado</th>
                            <th>Transporte</th>
                            <th>GAM</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% citas.forEach(c => { %>
                            <tr>
                                <td><%= c.Fecha || '-' %></td>
                                <td><%= c.Hora || '-' %></td>
                                <td><%= c.MascotaNombre || '-' %></td>
                                <td><%= c.ClienteNombre || '-' %></td>
                                <td><%= c.Servicio || '-' %></td>
                                <td><%= c.Estado || 'Pendiente' %></td>
                                <td>
                                    <% if (c.TransporteNecesario === 1 || c.TransporteNecesario === true) { %>
                                        <span class="badge bg-info">Sí</span>
                                        <br>
                                        <small><%= c.TipoTransporte || 'No especificado' %> - ₡<%= c.CostoTransporte || 0 %></small>
                                    <% } else { %>
                                        <span class="badge bg-secondary">No</span>
                                    <% } %>
                                </td>
                                <td>
                                    <%
                                        const provinciasGAM = ['San José', 'Heredia', 'Alajuela', 'Cartago'];
                                        const enGAM = provinciasGAM.includes(c.Provincia);
                                    %>
                                    <% if (enGAM) { %>
                                        <span class="badge bg-success">Sí</span>
                                    <% } else { %>
                                        <span class="badge bg-warning text-dark">No</span>
                                    <% } %>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-primary"
                                            data-id="<%= c.Id %>"
                                            data-fecha="<%= c.FechaISO || '' %>"
                                            data-hora="<%= c.Hora || '' %>"
                                            data-estado="<%= c.Estado || 'Pendiente' %>"
                                            onclick="openEditModal(this)">
                                        Editar
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<!-- Modal Editar Cita -->
<div id="editarCitaModal" class="modal">
    <div class="modal-content card">
        <div class="modal-header">
            <h3 class="modal-title">Editar Cita</h3>
            <button class="close" onclick="closeModal('editarCitaModal')">&times;</button>
        </div>
        <form id="formEditarCita" method="POST">
            <input type="hidden" name="Id" id="editarIdCita">

            <div class="form-group">
                <label>Fecha</label>
                <input type="date" name="Fecha" id="editarFecha" class="form-control">
            </div>
            <div class="form-group">
                <label>Hora (24 horas)</label>
                <input type="time" name="Hora" id="editarHora" class="form-control">
            </div>
            <div class="form-group">
                <label>Estado</label>
                <select name="Estado" id="editarEstado" class="form-control">
                    <option value="Pendiente">Pendiente</option>
                    <option value="Confirmada">Confirmada</option>
                    <option value="Completada">Completada</option>
                    <option value="Cancelada">Cancelada</option>
                </select>
            </div>

            <div class="form-group">
                <label>Requiere transporte:</label>
                <input type="text" class="form-control" readonly disabled
                       value="<%= typeof c !== 'undefined' && c.TransporteNecesario === 1 ? 'Sí' : 'No' %>">
            </div>

            <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem;">
                <button type="button" class="btn btn-secondary" onclick="closeModal('editarCitaModal')">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

<script>
function openEditModal(button) {
    const id     = button.getAttribute('data-id');
    const fecha  = button.getAttribute('data-fecha');
    const hora   = button.getAttribute('data-hora');
    const estado = button.getAttribute('data-estado');

    document.getElementById('editarIdCita').value = id;
    document.getElementById('editarFecha').value  = fecha;
    document.getElementById('editarHora').value   = hora;
    document.getElementById('editarEstado').value = estado;

    document.getElementById('formEditarCita').action = '/citas/editar/' + id;
    openModal('editarCitaModal');
}

function openModal(id)  { document.getElementById(id).style.display = 'flex'; }
function closeModal(id) { document.getElementById(id).style.display = 'none'; }

// Muestra el modal de error si viene un mensaje en la URL
(function() {
    const params = new URLSearchParams(window.location.search);
    const error  = params.get('error');
    if (error) {
        document.getElementById('errorModalMsg').textContent = decodeURIComponent(error);
        openModal('errorModal');

        // Limpia el ?error= de la URL sin recargar
        params.delete('error');
        const nueva = params.toString()
            ? `${window.location.pathname}?${params}`
            : window.location.pathname;
        window.history.replaceState({}, '', nueva);
    }
})();
</script>