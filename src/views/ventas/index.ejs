<% title = 'Punto de Venta' %>

<div class="page-header">
    <h1 class="page-title">Punto de Venta</h1>
    <p class="page-subtitle">Registro rápido de ventas</p>
</div>

<div class="pos-container">
    <!-- Sección de Productos -->
    <div class="products-section">
        <div class="search-box">
            <input type="text" class="search-input" placeholder="Buscar producto..." id="searchInput">
            <button class="search-btn">
                <i class="fas fa-search"></i>
            </button>
        </div>

        <div class="categories">
            <button class="category-btn active" data-category="all">Todos</button>
            <button class="category-btn" data-category="medicamento">Medicamentos</button>
            <button class="category-btn" data-category="alimento">Alimentos</button>
            <button class="category-btn" data-category="accesorio">Accesorios</button>
            <button class="category-btn" data-category="higiene">Higiene</button>
        </div>

        <div class="products-grid" id="productsGrid">
            <!-- Los productos se cargan dinámicamente -->
        </div>
    </div>

    <!-- Sección del Carrito -->
    <div class="cart-section">
        <h3 class="cart-title">Carrito de Venta</h3>

        <div class="customer-section">
            <div class="customer-info">
                <div>
                    <div class="customer-name">Cliente: Venta General</div>
                    <div class="customer-subtitle">Sin cliente asignado</div>
                </div>
                <span class="change-customer" onclick="openModal('seleccionarClienteModal')">
                    <i class="fas fa-edit"></i> Cambiar
                </span>
            </div>
        </div>

        <div class="cart-items" id="cartItems">
            <div class="cart-empty" id="cartEmpty">
                <i class="fas fa-shopping-cart cart-empty-icon"></i>
                <p>El carrito está vacío</p>
            </div>
        </div>

        <div class="cart-summary" id="cartSummary" style="display: none;">
            <div class="summary-row">
                <span>Subtotal:</span>
                <span id="subtotal">$0.00</span>
            </div>
            <div class="summary-row">
                <span>Descuento:</span>
                <span id="discount">$0.00</span>
            </div>
            <div class="summary-row summary-total">
                <span>Total:</span>
                <span id="total">$0.00</span>
            </div>

            <div class="payment-section">
                <div class="form-group">
                    <label class="form-label">Método de Pago</label>
                    <select class="form-control" id="paymentMethod">
                        <option value="efectivo">Efectivo</option>
                        <option value="tarjeta">Tarjeta</option>
                        <option value="transferencia">Transferencia</option>
                    </select>
                </div>

                <button class="btn btn-success btn-full" onclick="processSale()">
                    <i class="fas fa-check"></i> Procesar Venta ($<span id="totalBtn">0.00</span>)
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para seleccionar cliente -->
<div id="seleccionarClienteModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title">Seleccionar Cliente</h3>
            <button class="close" onclick="closeModal('seleccionarClienteModal')">&times;</button>
        </div>

        <div class="search-box modal-search-box">
            <input type="text" class="search-input" placeholder="Buscar cliente..." id="searchCliente">
            <button class="search-btn">
                <i class="fas fa-search"></i>
            </button>
        </div>

        <div class="modal-body-scroll">
            <div class="client-option" onclick="selectCustomer('Venta General', '')">
                <strong>Venta General</strong>
                <span class="client-option-subtitle">Sin cliente asignado</span>
            </div>
            <div class="client-option" onclick="selectCustomer('María González', 'CLI-001')">
                <strong>María González</strong>
                <span class="client-option-subtitle">CLI-001 • 2 mascotas</span>
            </div>
            <div class="client-option" onclick="selectCustomer('Carlos López', 'CLI-002')">
                <strong>Carlos López</strong>
                <span class="client-option-subtitle">CLI-002 • 1 mascota</span>
            </div>
            <div class="client-option" onclick="selectCustomer('Ana Martínez', 'CLI-003')">
                <strong>Ana Martínez</strong>
                <span class="client-option-subtitle">CLI-003 • 1 mascota</span>
            </div>
        </div>
    </div>
</div>

<script>
    // Datos de productos (dummy)
    const products = [
        { id: 1, name: "Antipulgas para perros", price: 25.00, category: "medicamento", stock: 15, icon: "fas fa-shield-alt" },
        { id: 2, name: "Alimento para perros 5kg", price: 18.50, category: "alimento", stock: 22, icon: "fas fa-bone" },
        { id: 3, name: "Arena para gatos 4kg", price: 12.00, category: "accesorio", stock: 18, icon: "fas fa-cat" },
        { id: 4, name: "Vacuna triple felina", price: 35.00, category: "medicamento", stock: 8, icon: "fas fa-syringe" },
        { id: 5, name: "Shampoo medicado", price: 10.00, category: "higiene", stock: 3, icon: "fas fa-pump-soap" },
        { id: 6, name: "Juguete para gatos", price: 8.00, category: "accesorio", stock: 25, icon: "fas fa-baseball-ball" },
        { id: 7, name: "Alimento para gatos 2kg", price: 15.00, category: "alimento", stock: 12, icon: "fas fa-fish" },
        { id: 8, name: "Correa para perros", price: 12.00, category: "accesorio", stock: 20, icon: "fas fa-dog" }
    ];

    let cart = [];
    let currentCategory = 'all';
    let currentCustomer = { name: 'Venta General', code: '' };

    // Inicializar productos
    function initializeProducts() {
        displayProducts(products);
        setupCategoryFilters();
        setupSearch();
    }

    // Mostrar productos
    function displayProducts(productsToShow) {
        const grid = document.getElementById('productsGrid');
        grid.innerHTML = '';

        productsToShow.forEach(product => {
            const productCard = document.createElement('div');
            productCard.className = 'product-card';
            productCard.onclick = () => addToCart(product);

            productCard.innerHTML = `
                <div class="product-icon">
                    <i class="${product.icon}"></i>
                </div>
                <div class="product-name">${product.name}</div>
                <div class="product-price">$${product.price.toFixed(2)}</div>
                <div class="product-stock ${product.stock < 5 ? 'stock-low' : ''}">
                    Stock: ${product.stock}
                </div>
            `;

            grid.appendChild(productCard);
        });
    }

    // Configurar filtros de categoría
    function setupCategoryFilters() {
        const categoryBtns = document.querySelectorAll('.category-btn');
        categoryBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                categoryBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentCategory = btn.dataset.category;
                filterProducts();
            });
        });
    }

    // Configurar búsqueda
    function setupSearch() {
        const searchInput = document.getElementById('searchInput');
        searchInput.addEventListener('input', filterProducts);
    }

    // Filtrar productos
    function filterProducts() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();

        let filteredProducts = products.filter(product => {
            const matchesSearch = product.name.toLowerCase().includes(searchTerm);
            const matchesCategory = currentCategory === 'all' || product.category === currentCategory;
            return matchesSearch && matchesCategory;
        });

        displayProducts(filteredProducts);
    }

    // Agregar al carrito
    function addToCart(product) {
        const existingItem = cart.find(item => item.id === product.id);

        if (existingItem) {
            existingItem.quantity += 1;
        } else {
            cart.push({
                id: product.id,
                name: product.name,
                price: product.price,
                quantity: 1
            });
        }

        updateCart();
    }

    // Actualizar carrito
    function updateCart() {
        const cartItems = document.getElementById('cartItems');
        const cartEmpty = document.getElementById('cartEmpty');
        const cartSummary = document.getElementById('cartSummary');

        if (cart.length === 0) {
            cartEmpty.style.display = 'block';
            cartSummary.style.display = 'none';
            cartItems.innerHTML = '';
            cartItems.appendChild(cartEmpty);
        } else {
            cartEmpty.style.display = 'none';
            cartSummary.style.display = 'block';

            cartItems.innerHTML = '';

            let subtotal = 0;

            cart.forEach(item => {
                const itemTotal = item.price * item.quantity;
                subtotal += itemTotal;

                const row = document.createElement('div');
                row.className = 'cart-item';

                row.innerHTML = `
                    <div class="cart-item-info">
                        <div class="cart-item-name">${item.name}</div>
                        <div class="cart-item-price">$${item.price.toFixed(2)} c/u</div>
                    </div>
                    <div class="cart-item-quantity">
                        <button class="quantity-btn" onclick="changeQuantity(${item.id}, -1)">-</button>
                        <input type="number" class="quantity-input" value="${item.quantity}"
                            onchange="setQuantity(${item.id}, this.value)" min="1">
                        <button class="quantity-btn" onclick="changeQuantity(${item.id}, 1)">+</button>
                    </div>
                    <div class="cart-item-total">
                        $${itemTotal.toFixed(2)}
                    </div>
                    <button class="btn-danger" onclick="removeFromCart(${item.id})">
                        <i class="fas fa-trash"></i>
                    </button>
                `;

                cartItems.appendChild(row);
            });

            document.getElementById('subtotal').textContent = `$${subtotal.toFixed(2)}`;
            document.getElementById('total').textContent = `$${subtotal.toFixed(2)}`;
            document.getElementById('totalBtn').textContent = subtotal.toFixed(2);
        }
    }

    // Cambiar cantidad
    function changeQuantity(productId, change) {
        const item = cart.find(item => item.id === productId);
        if (item) {
            item.quantity += change;
            if (item.quantity < 1) item.quantity = 1;
            updateCart();
        }
    }

    // Establecer cantidad
    function setQuantity(productId, quantity) {
        const item = cart.find(item => item.id === productId);
        if (item) {
            const q = parseInt(quantity, 10);
            item.quantity = isNaN(q) || q < 1 ? 1 : q;
            updateCart();
        }
    }

    // Remover del carrito
    function removeFromCart(productId) {
        cart = cart.filter(item => item.id !== productId);
        updateCart();
    }

    // Seleccionar cliente
    function selectCustomer(name, code) {
        currentCustomer = { name, code };

        const nameEl = document.querySelector('.customer-name');
        const subtitleEl = document.querySelector('.customer-subtitle');

        if (nameEl && subtitleEl) {
            nameEl.textContent = `Cliente: ${name}`;
            subtitleEl.textContent = code ? `Código: ${code}` : 'Sin cliente asignado';
        }

        closeModal('seleccionarClienteModal');
    }

    // Procesar venta
    function processSale() {
        if (cart.length === 0) {
            alert('El carrito está vacío');
            return;
        }

        const paymentMethod = document.getElementById('paymentMethod').value;
        const total = document.getElementById('total').textContent;
        const customerInfo = currentCustomer.code
            ? `Cliente: ${currentCustomer.name} (${currentCustomer.code})`
            : 'Cliente: Venta General';

        const saleId = 'V-' + Math.random().toString(36).substr(2, 9).toUpperCase();

        alert(
            `✅ Venta procesada exitosamente!\n\n` +
            `N° Venta: ${saleId}\n` +
            `${customerInfo}\n` +
            `Total: ${total}\n` +
            `Método de pago: ${paymentMethod}\n\n` +
            `¡Gracias por su compra!`
        );

        // Reset
        cart = [];
        updateCart();
        document.getElementById('paymentMethod').value = 'efectivo';
        selectCustomer('Venta General', '');
    }

    // Helpers de modal (usando los mismos estilos/funciones que ya tengas)
    function openModal(id) {
        const modal = document.getElementById(id);
        if (modal) modal.style.display = 'block';
    }

    function closeModal(id) {
        const modal = document.getElementById(id);
        if (modal) modal.style.display = 'none';
    }

    document.addEventListener('DOMContentLoaded', initializeProducts);
</script>
