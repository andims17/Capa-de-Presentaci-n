<% title='Punto de Venta' %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>
<style>
    .manual-discounts {
        display: flex;
        gap: 4px;
        margin-top: 5px;
    }
    .btn-desc {
        padding: 2px 8px;
        font-size: 11px;
        cursor: pointer;
        border: 1px solid #ddd;
        background: #f8f9fa;
        border-radius: 4px;
        transition: all 0.2s;
    }
    .btn-desc:hover { background: #e2e6ea; }
    .btn-desc.active {
        background: #28a745;
        color: white;
        border-color: #1e7e34;
        font-weight: bold;
    }
    .price-old {
        text-decoration: line-through;
        color: #dc3545;
        font-size: 0.85em;
        margin-right: 5px;
    }
    .cart-item-info { flex: 1; }
    .grooming-cart-detail {
        font-size: 0.78em;
        color: var(--text-secondary, #64748B);
        margin-top: 2px;
        line-height: 1.4;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Punto de Venta</h1>
    <p class="page-subtitle">Registro rápido de ventas</p>
</div>

<div class="pos-container">
    <div class="products-section">
        <div class="search-box">
            <input type="text" class="search-input" placeholder="Buscar por nombre o código..." id="searchInput" onkeyup="filterProducts()">
            <button class="search-btn">
                <i class="fas fa-search"></i>
            </button>
        </div>

        <div class="categories">
            <button class="category-btn active" data-category="all" onclick="setCategory('all', this)">Todos</button>
            <button class="category-btn" data-category="medicamento" onclick="setCategory('medicamento', this)">Medicamentos</button>
            <button class="category-btn" data-category="alimento" onclick="setCategory('alimento', this)">Alimentos</button>
            <button class="category-btn" data-category="accesorio" onclick="setCategory('accesorio', this)">Accesorios</button>
            <button class="category-btn" data-category="higiene" onclick="setCategory('higiene', this)">Higiene</button>
        </div>

        <div class="products-grid" id="productsGrid"></div>
    </div>

    <div class="cart-section">
        <h3 class="cart-title">Carrito de Venta</h3>

        <div class="customer-section">
            <div class="customer-info">
                <div>
                    <input type="hidden" id="selectedCustomerId" value="">
                    <div class="customer-name" id="displayCustomerName">Cliente: Venta General</div>
                    <div class="customer-subtitle" id="displayCustomerCode">Sin cliente asignado</div>
                </div>
                <span class="change-customer" onclick="openModal('seleccionarClienteModal')">
                    <i class="fas fa-edit"></i> Cambiar
                </span>
            </div>
        </div>

        <div class="cart-items" id="cartItems">
            <div class="cart-empty" id="cartEmpty">
                <i class="fas fa-shopping-cart cart-empty-icon"></i>
                <p>El carrito está vacío</p>
            </div>
        </div>

        <div class="cart-summary" id="cartSummary" style="display: none;">
            <div class="summary-row">
                <span>Subtotal:</span>
                <span id="subtotal">₡0.00</span>
            </div>
            <div class="summary-row">
                <span>IVA (13%):</span>
                <span id="tax-display">₡0.00</span>
            </div>
            <div class="summary-row summary-total">
                <span>Total:</span>
                <span id="total">₡0.00</span>
            </div>

            <div class="payment-section">
                <div class="form-group">
                    <label class="form-label">Método de Pago</label>
                    <select class="form-control" id="paymentMethod" onchange="toggleEfectivoFields()">
                        <option value="efectivo">Efectivo</option>
                        <option value="tarjeta">Tarjeta</option>
                        <option value="transferencia">Transferencia</option>
                    </select>
                </div>

                <div id="efectivoSection">
                    <div class="form-group">
                        <label class="form-label">Monto recibido</label>
                        <input type="number" class="form-control" id="montoRecibido"
                               placeholder="₡0" min="0" step="100"
                               oninput="calcularVuelto()">
                    </div>
                    <div class="summary-row" id="vueltoRow" style="display:none;">
                        <span style="font-weight:600;">Vuelto:</span>
                        <span id="vueltoDisplay" style="font-weight:700; color:var(--success,#10B981); font-size:1.1rem;">₡0</span>
                    </div>
                    <div class="summary-row" id="faltaRow" style="display:none;">
                        <span style="font-weight:600;">Falta:</span>
                        <span id="faltaDisplay" style="font-weight:700; color:var(--danger,#EF4444); font-size:1.1rem;">₡0</span>
                    </div>
                </div>

                <button class="btn btn-success btn-full" onclick="processSale()">
                    <i class="fas fa-check"></i> Procesar Venta (<span id="totalBtn">₡0.00</span>)
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Grooming -->
<div id="modalGrooming" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title"><i class="fas fa-cut"></i> Programar Servicio de Grooming</h3>
            <button class="close" onclick="closeGroomingModal()">&times;</button>
        </div>
        <div class="form-group">
            <label class="form-label">1. Seleccionar Cliente</label>
            <select id="citaClienteId" class="form-control"><option value="">-- Seleccione un cliente --</option></select>
        </div>
        <div class="form-group">
            <label class="form-label">2. Seleccionar Mascota</label>
            <select id="citaMascotaId" class="form-control" onchange="actualizarPrecioGrooming()"><option value="">-- Seleccione la mascota --</option></select>
        </div>
        <div class="two-cols">
            <div class="form-group"><label class="form-label">Fecha</label><input id="citaFecha" type="date" class="form-control" required></div>
            <div class="form-group"><label class="form-label">Hora</label><input id="citaHora" type="time" class="form-control" required></div>
        </div>
        <div class="two-cols">
            <div class="form-group"><label class="form-label">Servicio</label><input id="citaServicio" type="text" class="form-control" value="Grooming" readonly></div>
            <div class="form-group"><label class="form-label">Provincia</label>
                <select id="citaProvincia" class="form-control" onchange="actualizarPrecioGrooming()">
                    <option value="San José">San José</option><option value="Alajuela">Alajuela</option>
                    <option value="Cartago">Cartago</option><option value="Heredia">Heredia</option>
                </select>
            </div>
        </div>
        <div class="form-group"><label><input type="checkbox" id="citaTransporte" onchange="toggleTransporteOptions()"> ¿Requiere Transporte?</label></div>
        <div id="opcionesTransporte" style="display:none;">
            <div class="form-group"><label class="form-label">Tipo de Transporte</label>
                <select id="citaTipoTransporte" class="form-control" onchange="actualizarPrecioGrooming()">
                    <option value="Solo Ida">Solo Ida</option>
                    <option value="Solo Vuelta">Solo Vuelta</option>
                    <option value="Ida y Vuelta">Ida y Vuelta</option>
                </select>
            </div>
        </div>

        <!-- Caja de precio -->
        <div id="groomingPrecioBox" class="purchase-card" style="display:none; margin-top:0.5rem;">
            <div class="purchase-header" style="margin-bottom:0.5rem;">
                <div class="purchase-info">
                    <h3 style="font-size:0.95rem;"><i class="fas fa-tag" style="color:var(--primary-dark,#0EA5E9);"></i> Desglose de Precio</h3>
                </div>
            </div>
            <div class="purchase-details">
                <div class="detail-item">
                    <span class="detail-label">Peso de la mascota</span>
                    <span class="detail-value" id="groomingPeso">-</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Servicio de Grooming</span>
                    <span class="detail-value" id="groomingCostoBase">-</span>
                </div>
                <div class="detail-item" id="groomingTransporteRow" style="display:none;">
                    <span class="detail-label">Transporte (<span id="groomingTipoTransporte"></span>)</span>
                    <span class="detail-value" id="groomingCostoTransporte">-</span>
                </div>
            </div>
            <div class="purchase-header" style="margin-bottom:0; border-top:1px solid var(--border-color,#E2E8F0); padding-top:0.75rem;">
                <span class="detail-label" style="font-weight:600;">Total del Servicio</span>
                <div class="purchase-amount">
                    <div class="purchase-total" id="groomingTotal">-</div>
                </div>
            </div>
        </div>
        <div id="groomingPrecioError" style="display:none; margin-top:0.5rem;" class="purchase-card">
            <div class="detail-item">
                <span style="color:var(--warning,#F59E0B);"><i class="fas fa-exclamation-triangle"></i></span>
                <span class="detail-value" id="groomingPrecioErrorMsg" style="color:var(--warning,#F59E0B);"></span>
            </div>
        </div>

        <div class="modal-actions">
            <button type="button" class="btn btn-plain" onclick="closeGroomingModal()">Cancelar</button>
            <button type="button" class="btn btn-primary" id="btnConfirmarGrooming" onclick="confirmGroomingAdd()" disabled>
                <i class="fas fa-cart-plus"></i> Agregar al Carrito
            </button>
        </div>
    </div>
</div>

<!-- Modal Seleccionar Cliente -->
<div id="seleccionarClienteModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 class="modal-title">Seleccionar Cliente</h3>
            <button class="close" onclick="closeModal('seleccionarClienteModal')">&times;</button>
        </div>
        <div class="modal-body-scroll" id="clientOptionsContainer">
            <div class="client-option" onclick="selectCustomer('Venta General', '', null)">
                <strong>Venta General</strong>
                <span class="client-option-subtitle">Sin cliente asignado</span>
            </div>
        </div>
    </div>
</div>

<script>
    var cart = [];
    var TAX_RATE = 0.13;
    var currentCustomer = { id: null, name: 'Venta General', code: '' };
    let tempGroomingData = null;
    var currentCategory = 'all';
    let groomingPrecioActual = 0;

    function setCategory(category, element) {
        currentCategory = category;
        document.querySelectorAll('.category-btn').forEach(btn => btn.classList.remove('active'));
        element.classList.add('active');
        filterProducts();
    }

    function aplicarDescuento(id, porcentaje) {
        const item = cart.find(i => i.id == id);
        if (item) {
            item.descuentoManual = (item.descuentoManual === porcentaje) ? 0 : porcentaje;
            updateCartUI();
        }
    }

    function toggleEfectivoFields() {
        const metodo = document.getElementById('paymentMethod').value;
        const section = document.getElementById('efectivoSection');
        section.style.display = metodo === 'efectivo' ? 'block' : 'none';
        if (metodo !== 'efectivo') {
            document.getElementById('montoRecibido').value = '';
            document.getElementById('vueltoRow').style.display = 'none';
            document.getElementById('faltaRow').style.display  = 'none';
        }
    }

    function calcularVuelto() {
        const totalEl = document.getElementById('total');
        if (!totalEl) return;
        const total = cart.reduce((acc, item) => {
        const precioFinal = item.precio * (1 - (item.descuentoManual || 0));
        return acc + (precioFinal * item.quantity);
        }, 0) * (1 + TAX_RATE);
        const recibido = parseFloat(document.getElementById('montoRecibido').value) || 0;

        const vueltoRow = document.getElementById('vueltoRow');
        const faltaRow  = document.getElementById('faltaRow');

        if (recibido <= 0) {
            vueltoRow.style.display = 'none';
            faltaRow.style.display  = 'none';
            return;
        }

        const diff = recibido - total;
        if (diff >= 0) {
            document.getElementById('vueltoDisplay').textContent = '₡' + diff.toLocaleString('es-CR');
            vueltoRow.style.display = 'flex';
            faltaRow.style.display  = 'none';
        } else {
            document.getElementById('faltaDisplay').textContent = '₡' + Math.abs(diff).toLocaleString('es-CR');
            faltaRow.style.display  = 'flex';
            vueltoRow.style.display = 'none';
        }
    }

    function toggleTransporteOptions() {
        const check = document.getElementById('citaTransporte').checked;
        document.getElementById('opcionesTransporte').style.display = check ? 'block' : 'none';
        actualizarPrecioGrooming();
    }

    async function cargarClientesDropdown() {
        const selectCliente = document.getElementById('citaClienteId');
        if (!selectCliente) return;
        selectCliente.innerHTML = '<option value="">Cargando...</option>';
        try {
            const response = await fetch('/ventas/clientes/listar');
            const clientes = await response.json();
            selectCliente.innerHTML = '<option value="">-- Seleccione un cliente --</option>';
            clientes.forEach(c => {
                const option = document.createElement('option');
                const id = c.Id || c.id || 0;
                const nombre = c.NombreCompleto || c.nombreCompleto || "Nombre no disponible";
                option.value = id;
                option.textContent = `${nombre} (ID: ${id})`;
                selectCliente.appendChild(option);
            });
        } catch (error) { console.error(error); }
    }

    async function cargarTodasLasMascotas() {
        const selectMascota = document.getElementById('citaMascotaId');
        if (!selectMascota) return;
        selectMascota.innerHTML = '<option value="">Cargando...</option>';
        try {
            const response = await fetch('/ventas/mascotas/todas');
            const mascotas = await response.json();
            selectMascota.innerHTML = '<option value="">-- Seleccione la mascota --</option>';
            mascotas.forEach(m => {
                const option = document.createElement('option');
                const id = m.Id || m.id || m.MascotaId;
                const nombre = m.Nombre || m.nombre || "Mascota";
                const peso = m.Peso || m.peso || 0;
                option.value = id;
                option.textContent = `${nombre} (${peso} kg)`;
                selectMascota.appendChild(option);
            });
        } catch (error) { console.error(error); }
    }

    async function actualizarPrecioGrooming() {
        const mascotaId = document.getElementById('citaMascotaId').value;
        const requiereTransporte = document.getElementById('citaTransporte').checked;
        const provincia = document.getElementById('citaProvincia').value;
        const tipoTransporte = document.getElementById('citaTipoTransporte').value;

        const boxPrecio = document.getElementById('groomingPrecioBox');
        const boxError = document.getElementById('groomingPrecioError');
        const btnConfirmar = document.getElementById('btnConfirmarGrooming');

        boxPrecio.style.display = 'none';
        boxError.style.display = 'none';
        btnConfirmar.disabled = true;
        groomingPrecioActual = 0;

        if (!mascotaId) return;

        try {
            const params = new URLSearchParams({
                mascotaId,
                transporte: requiereTransporte ? '1' : '0',
                provincia,
                tipoTransporte
            });
            const res = await fetch(`/ventas/grooming/precio?${params}`);
            const data = await res.json();

            if (!res.ok || data.error) {
                document.getElementById('groomingPrecioErrorMsg').textContent = data.error || 'Error al calcular precio';
                boxError.style.display = 'block';
                return;
            }

            document.getElementById('groomingPeso').textContent = `${data.peso} kg`;
            document.getElementById('groomingCostoBase').textContent = `₡${data.costoGrooming.toLocaleString()}`;

            const rowTransporte = document.getElementById('groomingTransporteRow');
            if (data.costoTransporte > 0) {
                document.getElementById('groomingTipoTransporte').textContent = tipoTransporte;
                document.getElementById('groomingCostoTransporte').textContent = `₡${data.costoTransporte.toLocaleString()}`;
                rowTransporte.style.display = 'flex';
            } else {
                rowTransporte.style.display = 'none';
            }

            document.getElementById('groomingTotal').textContent = `₡${data.total.toLocaleString()}`;

            groomingPrecioActual = data.total;
            boxPrecio.style.display = 'block';
            btnConfirmar.disabled = false;

        } catch (err) {
            document.getElementById('groomingPrecioErrorMsg').textContent = 'No se pudo conectar al servidor.';
            boxError.style.display = 'block';
        }
    }

    function abrirModalGrooming() {
        document.getElementById('groomingPrecioBox').style.display = 'none';
        document.getElementById('groomingPrecioError').style.display = 'none';
        document.getElementById('btnConfirmarGrooming').disabled = true;
        document.getElementById('citaTransporte').checked = false;
        document.getElementById('opcionesTransporte').style.display = 'none';
        groomingPrecioActual = 0;

        cargarClientesDropdown();
        cargarTodasLasMascotas();
        document.getElementById('modalGrooming').style.display = 'flex';
    }

    async function filterProducts() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
        try {
            const response = await fetch(`/ventas/buscar?q=${searchTerm}&category=${currentCategory}`);
            const data = await response.json();
            const grid = document.getElementById('productsGrid');
            grid.innerHTML = '';

            data.forEach(p => {
                renderProductCard(p.Id || p.id, p.Nombre || p.nombre, parseFloat(p.Precio || p.precio), parseInt(p.Stock || p.stock), p.EsCritico || false, grid);
            });

            if ((searchTerm === '' || "grooming".includes(searchTerm)) && (currentCategory === 'all' || currentCategory === 'servicio')) {
                const groomingCard = document.createElement('div');
                groomingCard.className = 'product-card';
                groomingCard.onclick = function () { addToCart(99999, "Servicio de Grooming", 0, 999); };
                groomingCard.innerHTML = `
                    <div class="product-icon"><i class="fas fa-cut"></i></div>
                    <div class="product-name">Servicio de Grooming</div>
                    <div class="product-price" style="color:#28a745;">Precio según mascota</div>
                    <div class="product-stock">Programar Cita</div>
                `;
                grid.appendChild(groomingCard);
            }
        } catch (error) { console.error("Error:", error); }
    }

    function renderProductCard(id, nombre, precio, stock, critico, grid) {
        const card = document.createElement('div');
        card.className = 'product-card';
        if (critico) card.style.border = "2px solid #dc3545";
        card.onclick = function () { addToCart(id, nombre, precio, stock); };
        card.innerHTML = `
            <div class="product-icon"><i class="fas fa-box"></i></div>
            <div class="product-name">${nombre}</div>
            <div class="product-price">₡${precio.toLocaleString()}</div>
            <div class="product-stock ${critico ? 'stock-low' : ''}">Stock: ${stock}</div>
        `;
        grid.appendChild(card);
    }

    function addToCart(id, nombre, precio, stockDisponible) {
        if (id === 99999) {
            tempGroomingData = { id, nombre, precio };
            abrirModalGrooming();
        } else {
            const existingItem = cart.find(item => item.id == id);
            if (existingItem) {
                if (existingItem.quantity >= stockDisponible) return alert("Stock insuficiente");
                existingItem.quantity += 1;
            } else {
                if (stockDisponible <= 0) return alert("Agotado");
                cart.push({ 
                    id, 
                    nombre, 
                    precio, 
                    quantity: 1, 
                    stockMax: stockDisponible, 
                    isGrooming: false,
                    descuentoManual: 0 
                });
            }
            updateCartUI();
        }
    }

    function closeGroomingModal() {
        document.getElementById('modalGrooming').style.display = 'none';
        tempGroomingData = null;
    }

    function confirmGroomingAdd() {
        const clienteId = document.getElementById('citaClienteId').value;
        const mascotaId = document.getElementById('citaMascotaId').value;
        const fecha = document.getElementById('citaFecha').value;
        const hora = document.getElementById('citaHora').value;
        const provincia = document.getElementById('citaProvincia').value;
        const requiereTransporte = document.getElementById('citaTransporte').checked;
        const tipoTransporte = document.getElementById('citaTipoTransporte').value;

        if (!mascotaId || !fecha || !hora) return alert("Seleccione mascota, fecha y hora");
        if (groomingPrecioActual <= 0) return alert("Espere a que se calcule el precio del servicio");

        const mascotaSelect = document.getElementById('citaMascotaId');
        const mascotaNombre = mascotaSelect.options[mascotaSelect.selectedIndex]?.text || '';
        let detalle = `Mascota: ${mascotaNombre} | ${fecha} ${hora}`;
        if (requiereTransporte) detalle += ` | Transporte ${tipoTransporte} (${provincia})`;

        const uniqueId = "groom_" + Date.now();
        cart.push({
            id: uniqueId,
            nombre: "Servicio de Grooming",
            precio: groomingPrecioActual,
            quantity: 1,
            isGrooming: true,
            descuentoManual: 0,
            detalle: detalle,
            spData: {
                MascotaId: mascotaId,
                ClienteId: clienteId, 
                Fecha: fecha,
                Hora: hora,
                Servicio: 'Grooming',
                TransporteNecesario: requiereTransporte,
                TipoTransporte: requiereTransporte ? tipoTransporte : null,
                Provincia: provincia
            }
        });

        updateCartUI();
        closeGroomingModal();
    }

    function updateCartUI() {
        const cartItems = document.getElementById('cartItems');
        const cartEmpty = document.getElementById('cartEmpty');
        const cartSummary = document.getElementById('cartSummary');
        if (cart.length === 0) {
            if (cartEmpty) cartEmpty.style.display = 'block';
            if (cartSummary) cartSummary.style.display = 'none';
            cartItems.innerHTML = '';
            actualizarEtiqueta('total', "₡0");
            return;
        }
        if (cartEmpty) cartEmpty.style.display = 'none';
        if (cartSummary) cartSummary.style.display = 'block';
        cartItems.innerHTML = '';
        let subtotal = 0;
        cart.forEach(item => {
            const desc = item.descuentoManual || 0;
            const precioFinal = item.precio * (1 - desc);
            const totalFila = precioFinal * item.quantity;
            subtotal += totalFila;

            const row = document.createElement('div');
            row.className = 'cart-item';
            row.innerHTML = `
                <div class="cart-item-info">
                    <div class="cart-item-name">${item.nombre}</div>
                    ${item.isGrooming && item.detalle ? `<div class="grooming-cart-detail"><i class="fas fa-info-circle"></i> ${item.detalle}</div>` : ''}
                    <div class="cart-item-price">
                        ${desc > 0 ? `<span class="price-old">₡${item.precio.toLocaleString()}</span>` : ''}
                        ₡${precioFinal.toLocaleString()}
                    </div>
                    <div class="manual-discounts">
                        <button class="btn-desc ${desc === 0.05 ? 'active' : ''}" onclick="aplicarDescuento('${item.id}', 0.05)">5%</button>
                        <button class="btn-desc ${desc === 0.10 ? 'active' : ''}" onclick="aplicarDescuento('${item.id}', 0.10)">10%</button>
                        <button class="btn-desc ${desc === 0.15 ? 'active' : ''}" onclick="aplicarDescuento('${item.id}', 0.15)">15%</button>
                    </div>
                </div>
                <div class="cart-item-quantity">
                    ${item.isGrooming ? '1' : `
                        <button class="quantity-btn" onclick="changeQty('${item.id}', -1)">-</button>
                        <span>${item.quantity}</span>
                        <button class="quantity-btn" onclick="changeQty('${item.id}', 1)">+</button>
                    `}
                </div>
                <div class="cart-item-total">₡${totalFila.toLocaleString()}</div>
                <button style="border:none; background:none; cursor:pointer; color:#dc3545;" onclick="removeItem('${item.id}')">
                    <i class="fas fa-trash"></i>
                </button>
            `;
            cartItems.appendChild(row);
        });
        const iva = subtotal * TAX_RATE;
        actualizarEtiqueta('subtotal', "₡" + subtotal.toLocaleString());
        actualizarEtiqueta('tax-display', "₡" + iva.toLocaleString());
        actualizarEtiqueta('total', "₡" + (subtotal + iva).toLocaleString());
        actualizarEtiqueta('totalBtn', (subtotal + iva).toLocaleString());
        calcularVuelto();
    }

    window.changeQty = function (id, delta) {
        const item = cart.find(i => i.id == id);
        if (item && !item.isGrooming) { 
            if (delta > 0 && item.quantity >= item.stockMax) return alert("Límite de stock");
            item.quantity += delta;
            if (item.quantity <= 0) removeItem(id);
            else updateCartUI();
        }
    };
    window.removeItem = function (id) {
        cart = cart.filter(i => i.id != id);
        updateCartUI();
    };
    function actualizarEtiqueta(id, valor) {
        const el = document.getElementById(id);
        if (el) el.innerHTML = valor;
    }

    window.processSale = async function () {
        if (cart.length === 0) return alert('El carrito está vacío');

        const subtotal = cart.reduce((acc, item) => {
            const precioFinal = item.precio * (1 - (item.descuentoManual || 0));
            return acc + (precioFinal * item.quantity);
        }, 0);
        const totalConIVA = subtotal * (1 + TAX_RATE);

        const metodo = document.getElementById('paymentMethod').value;
        if (metodo === 'efectivo') {
            const recibido = parseFloat(document.getElementById('montoRecibido').value) || 0;
            if (recibido <= 0) return alert('Ingrese el monto recibido en efectivo.');
            if (recibido < totalConIVA) return alert('El monto recibido es menor al total de la venta.');
        }

        const saleData = {
            clienteId: currentCustomer.id || 0,
            total: totalConIVA, 
            productos: cart.map(p => ({
                ProductoId: p.isGrooming ? 99999 : p.id, 
                Cantidad: p.quantity,
                Precio: p.precio * (1 - (p.descuentoManual || 0))
            })),
            datosCita: cart.find(i => i.isGrooming)?.spData || null
        };

        try {
            const response = await fetch('/ventas/pagar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(saleData)
            });
            const result = await response.json();

            if (result.success) {
                await generarPDFFactura(result.ventaId, saleData);
                alert("Venta procesada y PDF generado.");
                location.reload();
            } else {
                alert("Error: " + result.message);
            }
        } catch (e) { console.error(e); }
    };

    async function generarPDFFactura(ventaId, saleData) {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        doc.setFontSize(18);
        doc.text("COMPROBANTE DE VENTA", 105, 20, { align: 'center' });
        doc.setFontSize(10);
        doc.text("Animales Fantasticos tienda de mascotas y Grooming", 10, 30);
        doc.text("Dirección: Moravia, San José, Costa Rica", 10, 40);
        doc.text(`Factura #: ${ventaId}`, 140, 30);
        doc.text(`Fecha: ${new Date().toLocaleString()}`, 140, 35);
        doc.text(`Cajero: Administrador`, 140, 40);
        
        doc.line(10, 50, 200, 50);
        doc.text(`Cliente: ${currentCustomer.name || "Venta General"}`, 10, 60);
        const columnas = ["Cant.", "Detalle", "Precio Unit.", "Desc.", "Total"];
        const filas = cart.map(p => {
            const descPorcentaje = (p.descuentoManual || 0) * 100;
            const precioConDesc = p.precio * (1 - (p.descuentoManual || 0));
            return [
                p.quantity,
                p.isGrooming ? `${p.nombre}${p.detalle ? '\n' + p.detalle : ''}` : p.nombre,
                `₡${p.precio.toLocaleString()}`, 
                `${descPorcentaje}%`,
                `₡${(precioConDesc * p.quantity).toLocaleString()}`
            ];
        });

        doc.autoTable({
            startY: 70,
            head: [columnas],
            body: filas,
            theme: 'grid',
            headStyles: { fillColor: [40, 167, 69] },
            styles: { fontSize: 9 }
        });
        const finalY = doc.lastAutoTable.finalY + 10;
        const obtenerMontoLimpio = (id) => {
            const el = document.getElementById(id);
            if (!el) return "0";
            return el.innerText.replace(/[^\d.,]/g, '').trim();
        };

        const subtotalPDF = obtenerMontoLimpio('subtotal');
        const ivaPDF = obtenerMontoLimpio('tax-display');
        const totalPDF = obtenerMontoLimpio('total');

        doc.setFont("helvetica", "normal");
        doc.text(`Subtotal: ₡${subtotalPDF}`, 140, finalY);
        doc.text(`IVA (13%): ₡${ivaPDF}`, 140, finalY + 5);
        doc.setFont("helvetica", "bold");
        doc.text(`TOTAL FINAL: ₡${totalPDF}`, 140, finalY + 12);
        doc.setFont("helvetica", "normal");
        doc.setFontSize(8);
        doc.text("Términos: Este documento es un comprobante de pago oficial.", 10, finalY + 30);

        doc.save(`Factura_${ventaId}.pdf`);
    }

    window.openModal = (id) => document.getElementById(id).style.display = 'flex';
    window.closeModal = (id) => document.getElementById(id).style.display = 'none';

    document.addEventListener('DOMContentLoaded', filterProducts);
</script>
