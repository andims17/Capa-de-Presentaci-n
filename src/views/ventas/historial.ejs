            </div>
        </div>

        <div class="sale-row">
            <strong>Cliente:</strong> <span>Carlos López (CLI-002)</span>
        </div>
        <div class="sale-row">
            <strong>Vendedor:</strong> <span>Admin</span>
        </div>
        <div class="sale-row">
            <strong>Método de pago:</strong>
            <span class="badge badge-info">Tarjeta</span>
        </div>

        <div class="sale-products">
            <strong>Productos:</strong>
            <div class="product-row">
                <span>Vacuna triple felina</span>
                <span>1 x $35.00 = $35.00</span>
            </div>
            <div class="product-row">
                <span>Arena para gatos 4kg</span>
                <span>1 x $12.00 = $12.00</span>
            </div>
            <div class="product-row">
                <span>Juguete para gatos</span>
                <span>1 x $8.00 = $8.00</span>
            </div>
            <div class="product-row">
