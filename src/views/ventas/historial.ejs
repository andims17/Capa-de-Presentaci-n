    <div class="sale-details">
        <div class="sale-header">
            <div>
                <strong>Venta #V-003</strong>
                <div class="sale-date">14/10/2024 14:20</div>
            </div>
            <div class="sale-status-amount">
                <div class="status-completed">Completada</div>
                <div class="sale-amount">$28.50</div>
            </div>
        </div>

        <div class="sale-row">
            <strong>Cliente:</strong> <span>Venta General</span>
        </div>
        <div class="sale-row">
            <strong>Vendedor:</strong> <span>Admin</span>
        </div>
        <div class="sale-row">
            <strong>Método de pago:</strong>
