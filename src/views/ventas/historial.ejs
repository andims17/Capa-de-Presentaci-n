<% title = 'Historial de Ventas' %>

<div class="page-header">
    <h1 class="page-title">Historial de Ventas</h1>
    <p class="page-subtitle">Registro completo de todas las ventas</p>
</div>

<div class="filters-row">
    <div class="form-group">
        <label class="form-label">Fecha Desde</label>
        <input type="date" class="form-control" value="2024-10-01">
    </div>

    <div class="form-group">
        <label class="form-label">Fecha Hasta</label>
        <input type="date" class="form-control" value="2024-10-15">
    </div>

    <div class="form-group">
        <label class="form-label">Estado</label>
        <select class="form-control">
            <option>Todos</option>
            <option>Completadas</option>
            <option>Pendientes</option>
            <option>Canceladas</option>
        </select>
    </div>

    <div class="form-group filters-row-actions">
        <button class="btn btn-primary">
            <i class="fas fa-filter"></i> Filtrar
        </button>
    </div>
</div>

<div class="card">
    <div class="card-header card-header-actions">
        <h2 class="card-title">Todas las Ventas</h2>
        <div class="card-header-buttons">
            <button class="btn btn-success">
                <i class="fas fa-file-export"></i> Exportar
            </button>
            <button class="btn btn-primary">
                <i class="fas fa-print"></i> Imprimir
            </button>
        </div>
    </div>

    <div class="sale-details">
        <div class="sale-header">
            <div>
                <strong>Venta #V-001</strong>
                <div class="sale-date">15/10/2024 10:30</div>
            </div>
            <div class="sale-status-amount">
                <div class="status-completed">Completada</div>
                <div class="sale-amount">$43.00</div>
            </div>
        </div>

        <div class="sale-row">
            <strong>Cliente:</strong> <span>María González (CLI-001)</span>
        </div>
        <div class="sale-row">
            <strong>Vendedor:</strong> <span>Admin</span>
        </div>
        <div class="sale-row">
            <strong>Método de pago:</strong>
            <span class="badge badge-success">Efectivo</span>
        </div>

        <div class="sale-products">
            <strong>Productos:</strong>
            <div class="product-row">
                <span>Antipulgas para perros grandes</span>
                <span>1 x $25.00 = $25.00</span>
            </div>
            <div class="product-row">
                <span>Alimento para perros 5kg</span>
                <span>1 x $18.00 = $18.00</span>
            </div>
        </div>

        <div class="sale-total">
            Total: $43.00
        </div>
    </div>

    <div class="sale-details">
