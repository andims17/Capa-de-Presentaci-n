<div class="page-header">
    <h1 class="page-title">Registro de Compras</h1>
    <p class="page-subtitle">Historial de entradas de inventario y compras</p>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Compras Realizadas</h2>
        <button class="btn btn-primary" onclick="openModal('nuevaCompraModal')">
            <i class="fas fa-plus"></i> Nueva Compra
        </button>
    </div>

    <div class="purchases-grid">
    <% if (compras && compras.length > 0) { %>
        <% compras.forEach(c => { %>
            <div class="purchase-card" data-activo="<%= c.Activo ? '1' : '0' %>">
                <div class="purchase-header">
                    <div class="purchase-info">
                        <h3>Compra #<%= c.Id %></h3>
                        <p>Proveedor: <%= c.Proveedor %></p>
                    </div>
                    <div class="purchase-amount">
                        <div class="purchase-total">₡<%= c.Total %></div>
                        <div class="purchase-date">
                            <%= new Date(c.Fecha).toLocaleDateString() %>
                        </div>
                    </div>
                </div>

                <div class="purchase-details">
                    <div class="detail-item">
                        <span class="detail-label">Proveedor:</span>
                        <span class="supplier-badge"><%= c.Proveedor %></span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Estado:</span>
                        <% if (c.Activo) { %>
                            <span class="status-received">Activa</span>
                        <% } else { %>
                            <span style="color:#EF4444;">Desactivada</span>
                        <% } %>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">Registrado por:</span>
                        <span class="detail-value"><%= c.Usuario %></span>
                    </div>
                </div>

                <div class="purchase-actions">
                    <% if (c.Activo) { %>
                        <form method="POST" action="/compras/<%= c.Id %>/desactivar">
                            <button class="btn btn-danger btn-sm">
                                <i class="fas fa-times"></i> Desactivar
                            </button>
                        </form>
                    <% } else { %>
                        <form method="POST" action="/compras/<%= c.Id %>/activar">
                            <button class="btn btn-success btn-sm">
                                <i class="fas fa-check"></i> Activar
                            </button>
                        </form>
                    <% } %>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <p>No hay compras registradas.</p>
    <% } %>
</div>

<style>
    .productos-compra-header,
    .producto-compra-row {
        display: grid;
        grid-template-columns: 1.1fr 1.6fr 0.8fr 0.9fr 1fr 52px;
        gap: 0.75rem;
        align-items: center;
    }

    .productos-compra-header {
        margin-bottom: 0.75rem;
        font-weight: 600;
    }

    .producto-compra-row {
        margin-bottom: 0.75rem;
    }

    .producto-compra-nombre {
        background-color: rgba(255,255,255,0.08);
        color: #fff;
    }

    .producto-compra-subtotal {
        background-color: rgba(255,255,255,0.08);
        color: #fff;
        font-weight: 600;
    }

    .producto-compra-row .btn-danger {
        width: 100%;
        min-width: 0;
        padding: 0.65rem 0.5rem;
    }

    @media (max-width: 900px) {
        .productos-compra-header {
            display: none;
        }

        .producto-compra-row {
            grid-template-columns: 1fr;
            background: rgba(255,255,255,0.03);
            padding: 0.75rem;
            border-radius: 10px;
        }
    }
</style>

<div class="stats-grid">
    <div class="stat-card stat-card-filter active" onclick="filtrarComprasPorEstado('todos', this)">
        <div class="stat-icon bg-cyan"><i class="fas fa-shopping-cart"></i></div>
        <div class="stat-value"><%= resumenCompras.TotalCompras || 0 %></div>
        <div class="stat-label">Todas</div>
    </div>

    <div class="stat-card stat-card-filter" onclick="filtrarComprasPorEstado('activas', this)">
        <div class="stat-icon bg-green"><i class="fas fa-check-circle"></i></div>
        <div class="stat-value"><%= resumenCompras.ComprasActivas || 0 %></div>
        <div class="stat-label">Activas</div>
    </div>

    <div class="stat-card stat-card-filter" onclick="filtrarComprasPorEstado('desactivadas', this)">
        <div class="stat-icon bg-red"><i class="fas fa-times-circle"></i></div>
        <div class="stat-value"><%= resumenCompras.ComprasDesactivadas || 0 %></div>
        <div class="stat-label">Desactivadas</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon bg-orange"><i class="fas fa-coins"></i></div>
        <div class="stat-value">₡<%= Number(resumenCompras.TotalInvertido || 0).toLocaleString() %></div>
        <div class="stat-label">Total Invertido</div>
    </div>
</div>

<div id="nuevaCompraModal" class="modal">
    <div class="modal-content modal-wide">
        <div class="modal-header">
            <h3 class="modal-title">Registrar Nueva Compra</h3>
            <button class="close" onclick="closeModal('nuevaCompraModal')">&times;</button>
        </div>

        <form method="POST" action="/inventario/compras/crear" onsubmit="prepararCompra(event)">
            <div class="two-cols">
                <div class="form-group">
                    <label class="form-label">Proveedor</label>
                    <select class="form-control" name="ProveedorId" required>
                        <option value="">Seleccionar proveedor</option>
                        <% if (proveedores && proveedores.length > 0) { %>
                            <% proveedores.forEach(proveedor => { %>
                                <option value="<%= proveedor.Id %>"><%= proveedor.Nombre %></option>
                            <% }) %>
                        <% } %>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Número de Factura</label>
                    <input type="text" class="form-control" placeholder="Número de factura">
                </div>
            </div>

            <div class="two-cols">
                <div class="form-group">
                    <label class="form-label">Fecha de Compra</label>
                    <input type="date" class="form-control">
                </div>

                <div class="form-group">
                    <label class="form-label">Fecha de Recepción</label>
                    <input type="date" class="form-control">
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Productos de la Compra</label>

                <div class="productos-compra-box">
                    <div class="productos-compra-header">
                        <div>Código</div>
                        <div>Nombre</div>
                        <div>Cantidad</div>
                        <div>Costo Unit.</div>
                        <div>Subtotal</div>
                        <div></div>
                    </div>

                    <div id="productosCompra"></div>

                    <button type="button" class="btn btn-gray full-width" onclick="agregarProductoCompra()">
                        <i class="fas fa-plus"></i> Agregar Producto
                    </button>
                </div>
            </div>

            <div class="two-cols mt-1">
                <div class="form-group">
                    <label class="form-label">Subtotal</label>
                    <input type="text" id="subtotalCompra" class="form-control" value="$0.00" readonly>
                </div>

                <div class="form-group">
                    <label class="form-label">Total</label>
                    <input type="text" id="totalCompra" class="form-control" value="$0.00" readonly>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Observaciones</label>
                <textarea class="form-control" rows="3" placeholder="Observaciones de la compra..."></textarea>
            </div>

            <div class="modal-actions">
                <button type="button" class="btn" onclick="closeModal('nuevaCompraModal')">
                    Cancelar
                </button>
                <input type="hidden" name="DetalleJSON" id="detalleJSON">
                <button type="submit" class="btn btn-primary">
                    Registrar Compra
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    let filtroCompraActual = 'todos';

    function filtrarComprasPorEstado(estado, cardSeleccionada = null) {
        filtroCompraActual = estado;

        document.querySelectorAll('.stat-card-filter').forEach(card => {
            card.classList.remove('active');
        });

        if (cardSeleccionada) {
            cardSeleccionada.classList.add('active');
        }

        aplicarFiltroCompras();
    }

    function aplicarFiltroCompras() {
        const cards = document.querySelectorAll('.purchase-card');

        cards.forEach(card => {
            const activo = card.dataset.activo === '1';

            let mostrar = true;

            if (filtroCompraActual === 'activas') {
                mostrar = activo;
            } else if (filtroCompraActual === 'desactivadas') {
                mostrar = !activo;
            }

            card.style.display = mostrar ? '' : 'none';
        });
    }
</script>

<script>
    let productoCount = 0;

    function agregarProductoCompra() {
        productoCount++;
        const container = document.getElementById('productosCompra');

        const row = document.createElement('div');
        row.className = 'producto-compra-row';
        row.innerHTML = `
            <input type="text" class="form-control producto-compra-codigo" placeholder="Código" onblur="buscarProductoPorCodigo(this)">
            <input type="text" class="form-control producto-compra-nombre" placeholder="Nombre del producto" readonly>
            <input type="number" class="form-control producto-compra-cantidad" value="1" min="1">
            <input type="number" class="form-control producto-compra-precio" value="0.00" step="0.01" min="0">
            <input type="text" class="form-control producto-compra-subtotal" value="₡0.00" readonly>
            <button type="button" class="btn btn-danger btn-xs" onclick="removerProductoCompra(this)">
                <i class="fas fa-times"></i>
            </button>
        `;

        container.appendChild(row);

        const cantidadInput = row.querySelector('.producto-compra-cantidad');
        const precioInput = row.querySelector('.producto-compra-precio');

        cantidadInput.addEventListener('input', actualizarTotalesCompra);
        precioInput.addEventListener('input', actualizarTotalesCompra);

        actualizarTotalesCompra();
    }

    async function buscarProductoPorCodigo(input) {
        const codigo = input.value.trim();
        const row = input.closest('.producto-compra-row');
        const nombreInput = row.querySelector('.producto-compra-nombre');
        const precioInput = row.querySelector('.producto-compra-precio');

        if (!codigo) {
            nombreInput.value = '';
            precioInput.value = '0.00';
            actualizarTotalesCompra();
            return;
        }

        try {
            const res = await fetch(`/inventario/producto-por-codigo/${encodeURIComponent(codigo)}`);

            if (!res.ok) {
                throw new Error('Producto no encontrado');
            }

            const producto = await res.json();

            nombreInput.value = producto.Nombre || '';
            nombreInput.title = producto.Nombre || '';
            precioInput.value = producto.Precio || 0;

            actualizarTotalesCompra();
        } catch (error) {
            nombreInput.value = '';
            nombreInput.title = '';
            precioInput.value = '0.00';
            actualizarTotalesCompra();
            alert('Producto no encontrado. Regístrelo primero en inventario.');
        }
    }

    function removerProductoCompra(button) {
        const row = button.closest('.producto-compra-row');
        row.remove();
        actualizarTotalesCompra();
    }

    function actualizarTotalesCompra() {
        let subtotal = 0;
        const rows = document.querySelectorAll('.producto-compra-row');

        rows.forEach(row => {
            const cantidad = parseFloat(row.querySelector('.producto-compra-cantidad').value) || 0;
            const precio = parseFloat(row.querySelector('.producto-compra-precio').value) || 0;
            const sub = cantidad * precio;

            row.querySelector('.producto-compra-subtotal').value = `₡${sub.toFixed(2)}`;
            subtotal += sub;
        });

        document.getElementById('subtotalCompra').value = `₡${subtotal.toFixed(2)}`;
        document.getElementById('totalCompra').value = `₡${subtotal.toFixed(2)}`;
    }
</script>

<script>
function prepararCompra(e) {
    const rows = document.querySelectorAll('.producto-compra-row');

    if (rows.length === 0) {
        alert('Debe agregar al menos un producto');
        e.preventDefault();
        return;
    }

    const detalle = [];

    for (let row of rows) {
        const codigo = row.querySelector('.producto-compra-codigo').value.trim();
        const nombre = row.querySelector('.producto-compra-nombre').value.trim();
        const cantidad = parseFloat(row.querySelector('.producto-compra-cantidad').value) || 0;
        const precio = parseFloat(row.querySelector('.producto-compra-precio').value) || 0;

        if (!codigo || !nombre) {
            alert('Hay productos sin validar. Verifique los códigos.');
            e.preventDefault();
            return;
        }

        if (cantidad <= 0 || precio <= 0) {
            alert('Cantidad y precio deben ser mayores a 0');
            e.preventDefault();
            return;
        }

        detalle.push({
            Codigo: codigo,
            Cantidad: cantidad,
            CostoUnitario: precio
        });
    }

    document.getElementById('detalleJSON').value = JSON.stringify(detalle);
}
</script>
