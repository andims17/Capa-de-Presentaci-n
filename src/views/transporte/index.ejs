<div class="page-header">
    <h1 class="page-title">Gestión de Transporte</h1>
    <p class="page-subtitle">Transportista único para traslado de mascotas en grooming</p>
</div>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger"><%= error %></div>
<% } %>

<% if (transportista) { %>
    <div class="card mb-4">
        <div class="card-header">
            <h2 class="card-title">Información del Transportista</h2>
            <button class="btn btn-primary btn-sm" onclick="openEditModal()">
                <i class="fas fa-edit"></i> Editar
            </button>
        </div>
        <div class="card-body">
            <p><strong>Conductor:</strong> <%= transportista.NombreConductor || '-' %></p>
            <p><strong>Vehículo:</strong> <%= transportista.TipoVehiculo || '-' %> (<%= transportista.Placa || 'Sin placa' %>)</p>
            <p><strong>Teléfono:</strong> <%= transportista.Telefono || '-' %></p>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Citas Asignadas al Transportista</h2>
        </div>
        <div class="card-body">
            <% if (citas.length === 0) { %>
                <p class="text-muted">No hay citas que requieran transporte.</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Hora</th>
                                <th>Tipo</th>
                                <th>Dirección</th>
                                <th>Precio</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% citas.forEach(cita => { %>
                                <tr>
                                <td><%= cita.Fecha || '-' %></td>
                                    <td><%= cita.Hora || '-' %></td>
                                    <td><%= cita.TipoTransporte || '-' %></td>
                                    <td><%= cita.DireccionCliente || 'No registrada' %></td>
                                    <td>₡<%= cita.CostoTransporte || 0 %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>
<% } else { %>
    <div class="alert alert-warning text-center">
        No hay transportista registrado.
    </div>
<% } %>

<!-- Modal Editar -->
<div id="editarTransporteModal" class="modal">
    <div class="modal-content card">
        <div class="modal-header">
            <h3 class="modal-title">Editar Transportista</h3>
            <button class="close" onclick="closeModal('editarTransporteModal')">&times;</button>
        </div>
        <form id="formEditarTransporte" method="POST" action="/transporte/editar">
            <div class="form-group">
                <label>Tipo de Vehículo</label>
                <input type="text" name="TipoVehiculo" class="form-control" required>
            </div>
            <div class="form-group">
                <label>Placa</label>
                <input type="text" name="Placa" class="form-control">
            </div>
            <div class="form-group">
                <label>Nombre del Conductor</label>
                <input type="text" name="NombreConductor" class="form-control" required>
            </div>
            <div class="form-group">
                <label>Teléfono</label>
                <input type="tel" name="Telefono" class="form-control">
            </div>

            <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem;">
                <button type="button" class="btn btn-secondary" onclick="closeModal('editarTransporteModal')">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

<script>
function openEditModal() {
    openModal('editarTransporteModal');
}

function openModal(id) { document.getElementById(id).style.display = 'block'; }
function closeModal(id) { document.getElementById(id).style.display = 'none'; }
</script>