<div class="page-header">
  <h1 class="page-title">Usuarios</h1>
  <p class="page-subtitle">Administración de usuarios (borrado lógico)</p>
</div>

<a href="/usuarios/nuevo" class="btn btn-primary" style="margin-bottom:1rem; display:inline-block;">
  <i class="fas fa-user-plus"></i> Nuevo usuario
</a>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">Listado</h2>
  </div>

  <div style="overflow:auto;">
    <table class="table" style="width:100%; border-collapse:collapse;">
      <thead>
        <tr>
          <th>ID</th>
          <th>Usuario</th>
          <th>Nombre</th>
          <th>Email</th>
          <th>Rol</th>
          <th>Activo</th>
          <th style="min-width:220px;">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(u => { %>
          <tr>
            <td><%= u.Id %></td>
            <td><%= u.Username %></td>
            <td><%= u.NombreCompleto %></td>
            <td><%= u.Email %></td>
            <td><%= u.RolNombre %></td>
            <td><%= u.Activo ? 'Sí' : 'No' %></td>
            <td>
              <a class="btn btn-secondary" href="/usuarios/<%= u.Id %>/editar">Editar</a>

              <% if (u.Activo) { %>
                <form method="POST" action="/usuarios/<%= u.Id %>/desactivar" style="display:inline;">
                  <button class="btn btn-danger" type="submit">Desactivar</button>
                </form>
              <% } else { %>
                <form method="POST" action="/usuarios/<%= u.Id %>/activar" style="display:inline;">
                  <button class="btn btn-primary" type="submit">Activar</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
