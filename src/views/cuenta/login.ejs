<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || 'Iniciar Sesión - VetPost' %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <script>
        (function() {
            try {
                const savedTheme = localStorage.getItem('theme');
                const html = document.documentElement;
                
                if (savedTheme === 'dark') {
                    html.setAttribute('data-theme', 'dark');
                } else if (!savedTheme) {
                    if (window.matchMedia) {
                        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                        if (prefersDark) {
                            html.setAttribute('data-theme', 'dark');
                            localStorage.setItem('theme', 'dark');
                        }
                    }
                }
            } catch (e) {
                console.warn('No se pudo aplicar el tema:', e);
            }
        })();
    </script>
    
    <style>
        :root {
            --primary-cyan: #7DD3FC;
            --primary-dark: #0EA5E9;
            --primary-light: #E0F2FE;
            --success: #10B981;
            --warning: #F59E0B;
            --danger: #EF4444;
            --gray-light: #F8FAFC;
            --gray-medium: #E2E8F0;
            --gray-dark: #64748B;
            --text-dark: #1E293B;
            --bg-secondary: #ffffff;
            --text-primary: #1E293B;
            --text-secondary: #64748B;
        }

        [data-theme="dark"] {
            --primary-cyan: #7DD3FC;
            --primary-dark: #0EA5E9;
            --primary-light: #1E3A5F;
            --bg-secondary: #1E293B;
            --text-primary: #F1F5F9;
            --text-secondary: #94A3B8;
            --gray-light: #1E293B;
            --gray-medium: #334155;
            --gray-dark: #94A3B8;
            --text-dark: #F1F5F9;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        body {
            background: linear-gradient(135deg, var(--primary-dark), var(--primary-cyan));
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        [data-theme="dark"] body {
            background: linear-gradient(135deg, #0C4A6E, #075985);
        }

        .login-container {
            background: var(--bg-secondary, white);
            border-radius: 15px;
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
            width: 90%;
            max-width: 450px;
            padding: 2.5rem;
        }

        [data-theme="dark"] .login-container {
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.5);
        }

        .login-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .logo {
            height: 48px;
            width: auto;
            object-fit: contain;
        }

        .login-title {
            font-size: 2.5rem;
            font-weight: bold;
            color: var(--text-primary, var(--text-dark));
            margin-bottom: 0.5rem;
        }

        .login-subtitle {
            color: var(--text-secondary, var(--gray-dark));
            font-size: 1.2rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            color: var(--text-primary, var(--text-dark));
        }

        .input-with-icon {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-secondary, var(--gray-dark));
        }

        .form-control {
            width: 100%;
            padding: 0.8rem 1rem 0.8rem 3rem;
            border: 1px solid var(--gray-medium);
            border-radius: 6px;
            font-size: 1rem;
            transition: border 0.3s;
            background-color: var(--bg-secondary, white);
            color: var(--text-primary, var(--text-dark));
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary-dark);
            box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.2);
        }

        .btn {
            width: 100%;
            padding: 0.8rem;
            border-radius: 6px;
            border: none;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 1.1rem;
        }

        .btn-primary {
            background-color: var(--primary-dark);
            color: white;
        }

        .btn-primary:hover {
            background-color: var(--primary-cyan);
        }

        .login-footer {
            text-align: center;
            margin-top: 1.5rem;
            color: var(--text-secondary, var(--gray-dark));
        }

        .alert {
            padding: 1rem;
            border-radius: 6px;
            margin-bottom: 1.5rem;
        }

        .alert-danger {
            background-color: rgba(239, 68, 68, 0.1);
            color: #991B1B;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

        [data-theme="dark"] .alert-danger {
            background-color: rgba(239, 68, 68, 0.2);
            color: #FCA5A5;
            border: 1px solid rgba(239, 68, 68, 0.4);
        }

        .divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 1.2rem 0;
            color: var(--text-secondary, var(--gray-dark));
            font-size: 0.95rem;
        }

        .divider::before,
        .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: var(--gray-medium);
        }

        .btn-outline {
            background: transparent;
            border: 1px solid var(--primary-dark);
            color: var(--primary-dark);
        }

        .btn-outline:hover {
        background: rgba(14, 165, 233, 0.12);
        }

    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-header">
            <img src="/img/animales-logo.jpeg" alt="Animales Fantásticos" class="logo" />
            <h1 class="login-title">VetPost</h1>
            <p class="login-subtitle">Sistema de Gestión Veterinaria</p>
        </div>

        <% if (error) { %>
            <div id="errorAlert" class="alert alert-danger">
                <%= error %>
            </div>
        <% } %>

        <form id="loginForm" method="POST" action="/cuenta/login">
            <div class="form-group">
                <label for="username" class="form-label">Usuario</label>
                <div class="input-with-icon">
                    <i class="fas fa-user input-icon"></i>
                    <input type="text" id="username" name="username" class="form-control" placeholder="Ingresa tu usuario" required>
                </div>
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Contraseña</label>
                <div class="input-with-icon">
                    <i class="fas fa-lock input-icon"></i>
                    <input type="password" id="password" name="password" class="form-control" placeholder="Ingresa tu contraseña" required>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-sign-in-alt"></i> Iniciar Sesión
            </button>
            <div class="divider">o</div>
            <a href="/cuenta/registro" class="btn btn-outline" style="text-decoration:none; display:inline-block; text-align:center;">
                <i class="fas fa-user-plus"></i> Crear cuenta
            </a>
        </form>

        <div class="login-footer">
            <p>¿Necesitas ayuda? Contacta al administrador</p>
        </div>
    </div>
</body>
</html>
