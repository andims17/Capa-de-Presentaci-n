<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title || 'Crear Cuenta - VetPost' %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

  <style>
    :root {
      --primary-cyan: #7DD3FC;
      --primary-dark: #0EA5E9;
      --primary-light: #E0F2FE;
      --gray-light: #F8FAFC;
      --gray-medium: #E2E8F0;
      --gray-dark: #64748B;
      --text-dark: #1E293B;
      --bg-secondary: #ffffff;
      --text-primary: #1E293B;
      --text-secondary: #64748B;
    }

    * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body {
      background: linear-gradient(135deg, var(--primary-dark), var(--primary-cyan));
      height: 100vh; display:flex; align-items:center; justify-content:center;
    }

    .box {
      background: var(--bg-secondary);
      border-radius: 15px;
      box-shadow: 0 15px 30px rgba(0,0,0,0.2);
      width: 90%;
      max-width: 520px;
      padding: 2.2rem;
    }

    h1 { font-size: 2rem; color: var(--text-primary); margin-bottom: 0.3rem; text-align:center; }
    p { color: var(--text-secondary); text-align:center; margin-bottom: 1.5rem; }

    .alert { padding: 1rem; border-radius: 6px; margin-bottom: 1rem; border: 1px solid rgba(239,68,68,0.3); background: rgba(239,68,68,0.1); color:#991B1B; }
    .row { display:flex; gap: 12px; }
    .row .form-group { flex:1; }

    .form-group { margin-bottom: 1rem; }
    .form-label { display:block; margin-bottom:0.4rem; font-weight:600; color: var(--text-primary); }
    .input-with-icon { position:relative; }
    .input-icon { position:absolute; left:1rem; top:50%; transform:translateY(-50%); color: var(--text-secondary); }
    .form-control {
      width:100%;
      padding:0.8rem 1rem 0.8rem 3rem;
      border: 1px solid var(--gray-medium);
      border-radius: 6px;
      font-size:1rem;
    }

    .btn { width:100%; padding:0.85rem; border-radius:6px; border:none; font-weight:700; cursor:pointer; font-size:1.05rem; }
    .btn-primary { background: var(--primary-dark); color:white; }
    .btn-primary:hover { background: var(--primary-cyan); }

    .btn-link { margin-top: 0.9rem; display:block; text-align:center; color: var(--primary-dark); text-decoration:none; font-weight:600; }
  </style>
</head>
<body>
  <div class="box">
    <h1>Crear cuenta</h1>
    <p>Registrá tu usuario para ingresar a VetPost</p>

    <% if (error) { %>
      <div class="alert"><%= error %></div>
    <% } %>

    <form method="POST" action="/cuenta/registro">
      <div class="row">
        <div class="form-group">
          <label class="form-label" for="username">Usuario</label>
          <div class="input-with-icon">
            <i class="fas fa-user input-icon"></i>
            <input class="form-control" id="username" name="username" required />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="nombreCompleto">Nombre completo</label>
          <div class="input-with-icon">
            <i class="fas fa-id-card input-icon"></i>
            <input class="form-control" id="nombreCompleto" name="nombreCompleto" required />
          </div>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="email">Email</label>
        <div class="input-with-icon">
          <i class="fas fa-envelope input-icon"></i>
          <input type="email" class="form-control" id="email" name="email" required />
        </div>
      </div>

      <div class="row">
        <div class="form-group">
          <label class="form-label" for="password">Contraseña</label>
          <div class="input-with-icon">
            <i class="fas fa-lock input-icon"></i>
            <input type="password" class="form-control" id="password" name="password" required />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="password2">Confirmar</label>
          <div class="input-with-icon">
            <i class="fas fa-lock input-icon"></i>
            <input type="password" class="form-control" id="password2" name="password2" required />
          </div>
        </div>
      </div>

      <hr style="margin: 1.5rem 0; border: none; border-top: 1px solid var(--gray-medium);" />
      
      <h3 style="font-size: 1.1rem; margin-bottom: 1rem; color: var(--text-primary);">Preguntas de Seguridad</h3>
      <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 1rem;">Estas preguntas te ayudarán a recuperar tu contraseña si la olvidas.</p>

      <div class="form-group">
        <label class="form-label" for="respuesta1">¿Nombre de tu primera mascota?</label>
        <input type="text" class="form-control" id="respuesta1" name="respuesta1" required />
      </div>

      <div class="form-group">
        <label class="form-label" for="respuesta2">¿Marca de tu primer auto?</label>
        <input type="text" class="form-control" id="respuesta2" name="respuesta2" required />
      </div>

      <button class="btn btn-primary" type="submit">
        <i class="fas fa-user-plus"></i> Crear cuenta
      </button>
    </form>

    <a class="btn-link" href="/cuenta/login">Volver al login</a>
  </div>
</body>
</html>
