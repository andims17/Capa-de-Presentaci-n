<% title = 'Bitácora de Auditoría' %>

<%
    const seccionActual = seccionActiva || 'usuarios';

    function obtenerClaseEvento(codigo) {
        if (!codigo) return 'badge-evento badge-evento-neutral';
        if (codigo.includes('ALTA') || codigo.includes('REGISTRO') || codigo.includes('ACTIVADO') || codigo.includes('CREADO') || codigo.includes('LOGIN') || codigo.includes('INICIO_SESION')) return 'badge-evento badge-evento-success';
        if (codigo.includes('DESACTIVADO') || codigo.includes('ELIMINADO')) return 'badge-evento badge-evento-danger';
        if (codigo.includes('CAMBIO_ROL') || codigo.includes('RESET_PASSWORD') || codigo.includes('EDITADO') || codigo.includes('LOGOUT') || codigo.includes('CIERRE_SESION')) return 'badge-evento badge-evento-warning';
        return 'badge-evento badge-evento-neutral';
    }

    function obtenerEtiquetaSeccion(seccion) {
        return seccion === 'reportes' ? 'Reportes' : 'Usuarios';
    }

    function esReciente(fecha) {
        const ahora = new Date();
        const evento = new Date(fecha);
        const diffHoras = (ahora - evento) / (1000 * 60 * 60);
        return diffHoras <= 24;
    }
%>

<style>
    .bitacora-summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .bitacora-total {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.75rem 1rem;
        border-radius: 12px;
        background: var(--bg-tertiary);
        color: var(--text-primary);
        border: 1px solid var(--border-color);
        font-weight: 600;
    }

    .bitacora-total i {
        color: var(--primary-dark);
    }

    .bitacora-note {
        color: var(--text-secondary);
        margin: 0;
    }

    .bitacora-tabs {
        display: inline-flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .bitacora-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }

    .bitacora-alert {
        margin-bottom: 1rem;
        padding: 0.75rem 1rem;
        border-radius: 10px;
        font-weight: 600;
    }

    .bitacora-alert.success {
        background: rgba(16, 185, 129, 0.12);
        color: #047857;
        border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .bitacora-alert.error {
        background: rgba(239, 68, 68, 0.12);
        color: #B91C1C;
        border: 1px solid rgba(239, 68, 68, 0.25);
    }

    .bitacora-alert.warning {
        background: rgba(245, 158, 11, 0.12);
        color: #B45309;
        border: 1px solid rgba(245, 158, 11, 0.25);
    }

    .btn-limpiar-reportes {
        border: 1px solid rgba(220, 38, 38, 0.35);
        background: rgba(220, 38, 38, 0.1);
        color: #B91C1C;
    }

    .btn-limpiar-reportes:hover {
        background: rgba(220, 38, 38, 0.16);
    }

    .bitacora-tab {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.75rem 1rem;
        border-radius: 999px;
        border: 1px solid var(--border-color);
        background: var(--bg-primary);
        color: var(--text-secondary);
        text-decoration: none;
        font-weight: 700;
        transition: all 0.2s ease;
    }

    .bitacora-tab:hover {
        color: var(--text-primary);
        border-color: var(--primary-color);
    }

    .bitacora-tab.activa {
        background: var(--primary-color);
        color: #fff;
        border-color: var(--primary-color);
        box-shadow: 0 10px 24px rgba(37, 99, 235, 0.22);
    }

    .bitacora-tab-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.8rem;
        height: 1.8rem;
        padding: 0 0.45rem;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.18);
        font-size: 0.85rem;
    }

    .bitacora-tab:not(.activa) .bitacora-tab-count {
        background: var(--bg-tertiary);
        color: var(--text-primary);
    }

    .badge-evento {
        display: inline-block;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.2px;
        white-space: nowrap;
    }

    .badge-evento-success {
        background: rgba(16, 185, 129, 0.14);
        color: #059669;
    }

    .badge-evento-danger {
        background: rgba(239, 68, 68, 0.14);
        color: #DC2626;
    }

    .badge-evento-warning {
        background: rgba(245, 158, 11, 0.14);
        color: #D97706;
    }

    .badge-evento-neutral {
        background: rgba(100, 116, 139, 0.14);
        color: #475569;
    }

    [data-theme="dark"] .badge-evento-success {
        color: #6EE7B7;
    }

    [data-theme="dark"] .badge-evento-danger {
        color: #FCA5A5;
    }

    [data-theme="dark"] .badge-evento-warning {
        color: #FCD34D;
    }

    [data-theme="dark"] .badge-evento-neutral {
        color: #CBD5E1;
    }

    .tabla-bitacora {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }

    .tabla-bitacora thead th {
        position: sticky;
        top: 0;
        background: var(--bg-secondary);
        z-index: 1;
    }

    .tabla-bitacora tbody tr.bitacora-reciente {
        background: rgba(125, 211, 252, 0.08);
    }

    [data-theme="dark"] .tabla-bitacora tbody tr.bitacora-reciente {
        background: rgba(14, 165, 233, 0.12);
    }

    .bitacora-usuario {
        font-weight: 600;
        color: var(--text-primary);
    }

    .bitacora-muted {
        color: var(--text-secondary);
        font-size: 0.9rem;
    }

    .bitacora-detalle {
        max-width: 320px;
        white-space: normal;
    }

    .bitacora-fecha {
        white-space: nowrap;
        font-weight: 600;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Bitácora de Auditoría</h1>
    <p class="page-subtitle">Consulta separada para actividad de usuarios y reportes del sistema</p>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Registro de Eventos del Sistema</h2>
    </div>
    <div class="card-body">
        <div class="bitacora-summary">
            <div class="bitacora-total">
                <i class="fas fa-clipboard-list"></i>
                <span>Mostrando <%= eventos ? eventos.length : 0 %> de <%= totalEventos || 0 %> eventos</span>
            </div>

            <p class="bitacora-note">
                Vista activa: <strong><%= obtenerEtiquetaSeccion(seccionActual) %></strong>. Los registros de las últimas 24 horas aparecen resaltados.
            </p>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header">
        <h2 class="card-title">Actividad Registrada</h2>
    </div>
    <div class="card-body">
        <% if (mensaje === 'limpieza_ok') { %>
            <div class="bitacora-alert success">Se limpiaron <%= cantidadEliminada || 0 %> eventos de reportes.</div>
        <% } else if (mensaje === 'limpieza_error') { %>
            <div class="bitacora-alert error">No se pudieron limpiar los eventos de reportes.</div>
        <% } else if (mensaje === 'solo_reportes') { %>
            <div class="bitacora-alert warning">La limpieza solo aplica para la sección Reportes.</div>
        <% } %>

        <div class="bitacora-actions">
            <div class="bitacora-tabs">
                <a href="/reportes/logs?seccion=usuarios" class="bitacora-tab <%= seccionActual === 'usuarios' ? 'activa' : '' %>">
                    <i class="fas fa-users"></i>
                    <span>Usuarios</span>
                    <span class="bitacora-tab-count"><%= resumenCategorias?.usuarios || 0 %></span>
                </a>
                <a href="/reportes/logs?seccion=reportes" class="bitacora-tab <%= seccionActual === 'reportes' ? 'activa' : '' %>">
                    <i class="fas fa-chart-line"></i>
                    <span>Reportes</span>
                    <span class="bitacora-tab-count"><%= resumenCategorias?.reportes || 0 %></span>
                </a>
            </div>

            <% if (seccionActual === 'reportes') { %>
                <form method="POST" action="/reportes/logs/limpiar" onsubmit="return confirm('¿Deseas limpiar todos los eventos de la sección Reportes?');">
                    <input type="hidden" name="seccion" value="reportes">
                    <button type="submit" class="btn btn-limpiar-reportes">
                        <i class="fas fa-broom"></i> Limpiar
                    </button>
                </form>
            <% } %>
        </div>

        <table class="table tabla-bitacora">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Acción</th>
                    <th>Quién</th>
                    <th>A quién</th>
                    <th>Detalle</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                <% if (eventos && eventos.length) { %>
                    <% eventos.forEach(e => { %>
                        <tr class="<%= esReciente(e.Fecha) ? 'bitacora-reciente' : '' %>">
                            <td class="bitacora-fecha">
                                <div><%= new Date(e.Fecha).toLocaleDateString() %></div>
                                <div class="bitacora-muted"><%= new Date(e.Fecha).toLocaleTimeString() %></div>
                            </td>
                            <td>
                                <span class="<%= obtenerClaseEvento(e.TipoCodigo) %>"><%= e.TipoEvento %></span>
                            </td>
                            <td>
                                <div class="bitacora-usuario"><%= e.ActorUsername || 'Sistema' %></div>
                                <div class="bitacora-muted"><%= e.ActorUsername ? 'Usuario ejecutor' : 'Proceso interno' %></div>
                            </td>
                            <td>
                                <div class="bitacora-usuario"><%= e.UsuarioAfectadoUsername || '-' %></div>
                                <div class="bitacora-muted"><%= e.UsuarioAfectadoUsername ? 'Usuario afectado' : 'Sin objetivo directo' %></div>
                            </td>
                            <td class="bitacora-detalle"><%= e.Detalle || '-' %></td>
                            <td><span class="bitacora-muted"><%= e.Ip || '-' %></span></td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="6">No hay eventos registrados en la sección <%= obtenerEtiquetaSeccion(seccionActual).toLowerCase() %>.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
