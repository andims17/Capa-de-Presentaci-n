<% title = 'Historial de Movimientos' %>

<div class="page-header">
    <h1 class="page-title">Historial de Movimientos</h1>
    <p class="page-subtitle">Registro de entradas y salidas del sistema</p>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Filtrar Movimientos</h2>
    </div>
    <div class="card-body">
        <form method="GET" action="/reportes/historial" class="row">
                <div class="form-group col-3">
                <label>Fecha Desde</label>
                <input type="text" name="desde" class="form-control flatpickr" value="<%= filtros && filtros.desde ? filtros.desde : '' %>">
            </div>

            <div class="form-group col-3">
                <label>Fecha Hasta</label>
                <input type="text" name="hasta" class="form-control flatpickr" value="<%= filtros && filtros.hasta ? filtros.hasta : '' %>">
            </div>

            <div class="form-group col-4">
                <label>Producto</label>
                <select name="producto" class="form-control">
                    <option value="">-- Seleccionar Producto --</option>
                    <% if (productos && productos.length) { %>
                        <% productos.forEach(p => { %>
                            <option value="<%= p.Id %>" <%= filtros && filtros.producto && String(filtros.producto) === String(p.Id) ? 'selected' : '' %>><%= p.Nombre %> (Stock: <%= p.Stock %>)</option>
                        <% }) %>
                    <% } %>
                </select>
            </div>

            <div class="form-group col-2" style="display:flex;align-items:flex-end;">
                <button class="btn btn-primary" type="submit">Buscar</button>
            </div>
        </form>
    </div>
</div>

<!-- Flatpickr: cargar tema según modo (light/dark), observar cambios y aplicar idioma español -->
<script>
  (function(){
    const head = document.head;
    const getTheme = () => document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';

    function insertCss(theme){
      let existing = document.getElementById('flatpickr-theme');
      const href = theme === 'dark'
        ? 'https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/dark.css'
        : 'https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css';

      if (existing) {
        existing.href = href;
        return;
      }

      existing = document.createElement('link');
      existing.rel = 'stylesheet';
      existing.id = 'flatpickr-theme';
      existing.href = href;
      head.appendChild(existing);
    }

    // Cargar CSS según tema actual
    insertCss(getTheme());

    // Cargar script de flatpickr y locale español
    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/flatpickr';
    script.onload = function(){
      // Cargar locale español
      const esLocale = document.createElement('script');
      esLocale.src = 'https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js';
      esLocale.onload = function(){
        flatpickr('.flatpickr', {
          dateFormat: 'Y-m-d',
          allowInput: true,
          locale: 'es'
        });
      };
      head.appendChild(esLocale);
        };
        head.appendChild(script);

        // Observar cambios en el atributo data-theme para actualizar CSS dinámicamente
        const obs = new MutationObserver(() => {
            insertCss(getTheme());
        });
        obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    })();
</script>

<div class="card mt-3">
    <div class="card-header">
        <h2 class="card-title">Listado de Movimientos</h2>
    </div>
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Acción</th>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Usuario</th>
                    <th>Referencia</th>
                </tr>
            </thead>
            <tbody>
                <% if (movimientos && movimientos.length) { %>
                    <% movimientos.forEach(m => { %>
                        <tr>
                            <td><%= new Date(m.Fecha).toLocaleString() %></td>
                            <td><%= m.Accion %></td>
                            <td><%= m.Producto %></td>
                            <td><%= m.Cantidad %></td>
                            <td><%= m.Usuario || 'Sistema' %></td>
                            <td><%= m.Referencia %></td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="6">No se encontraron movimientos para los filtros seleccionados.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>
