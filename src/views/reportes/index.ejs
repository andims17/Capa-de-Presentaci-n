<% title = 'Reportes y Estadísticas' %>

<div class="page-header">
    <h1 class="page-title">Reportes y Estadísticas</h1>
    <p class="page-subtitle">Análisis y datos reales del sistema</p>
</div>

<div style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:24px;">
    <button class="btn btn-secondary" onclick="location.href='/reportes/historial'">
        <i class="fas fa-history"></i> Historial de Movimientos
    </button>
    <button class="btn btn-secondary" onclick="location.href='/ventas/historial'">
        <i class="fas fa-receipt"></i> Historial de Ventas
    </button>
    <button class="btn btn-success" onclick="exportarPDF()">
        <i class="fas fa-file-pdf"></i> Exportar PDF
    </button>
    <button class="btn btn-primary" onclick="imprimirReporte()">
        <i class="fas fa-print"></i> Imprimir
    </button>
    <button class="btn btn-secondary" onclick="location.href='/reportes/logs'">
        <i class="fas fa-clipboard-list"></i> Bitácora de Auditoría
    </button>
</div>

<div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:16px; margin-bottom:24px;">

    <div class="card" style="padding:20px; text-align:center;">
        <div style="font-size:1.6rem; font-weight:bold; color:#28a745;">
            ₡<%= parseFloat(ventas.IngresosMes || 0).toLocaleString('es-CR') %>
        </div>
        <div style="color:#6c757d; margin-top:4px; font-size:0.9em;">Ingresos este mes</div>
        <div style="font-size:0.78em; color:#aaa; margin-top:4px;">
            <%= ventas.VentasMes || 0 %> ventas realizadas
        </div>
    </div>

    <div class="card" style="padding:20px; text-align:center;">
        <div style="font-size:1.6rem; font-weight:bold; color:#17a2b8;">
            ₡<%= parseFloat(ventas.IngresosTotales || 0).toLocaleString('es-CR') %>
        </div>
        <div style="color:#6c757d; margin-top:4px; font-size:0.9em;">Ingresos totales</div>
        <div style="font-size:0.78em; color:#aaa; margin-top:4px;">
            <%= ventas.TotalVentas || 0 %> ventas históricas
        </div>
    </div>

    <div class="card" style="padding:20px; text-align:center;">
        <div style="font-size:1.6rem; font-weight:bold; color:#fd7e14;">
            <%= citas.TotalCitas || 0 %>
        </div>
        <div style="color:#6c757d; margin-top:4px; font-size:0.9em;">Citas registradas</div>
        <div style="font-size:0.78em; color:#aaa; margin-top:4px;">
            <%= citas.Pendientes || 0 %> pendientes ·
            <%= citas.Confirmadas || 0 %> confirmadas
        </div>
    </div>

    <div class="card" style="padding:20px; text-align:center;">
        <div style="font-size:1.6rem; font-weight:bold;
                    color:<%= productosBajoStock > 0 ? '#dc3545' : '#28a745' %>;">
            <%= productosBajoStock %>
        </div>
        <div style="color:#6c757d; margin-top:4px; font-size:0.9em;">Productos bajo stock</div>
        <div style="font-size:0.78em; margin-top:4px;">
            <% if (productosBajoStock > 0) { %>
                <a href="/inventario" style="color:#dc3545;">Ver inventario →</a>
            <% } else { %>
                <span style="color:#28a745;">Todo en orden ✓</span>
            <% } %>
        </div>
    </div>
</div>

<div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px;">
    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Ventas últimos 7 días</h2>
        </div>
        <div style="padding:16px;">
            <% if (ventasPorDia && ventasPorDia.length > 0) { %>
                <% const maxTotal = Math.max(...ventasPorDia.map(d => parseFloat(d.Total) || 0), 1); %>
                <% ventasPorDia.forEach(dia => { %>
                    <% const pct = Math.round((parseFloat(dia.Total) / maxTotal) * 100); %>
                    <div style="margin-bottom:12px;">
                        <div style="display:flex; justify-content:space-between; font-size:0.82em; margin-bottom:4px;">
                            <span>
                                <%= new Date(dia.Dia).toLocaleDateString('es-CR', {weekday:'short', day:'numeric', month:'short'}) %>
                            </span>
                            <span style="font-weight:bold;">
                                ₡<%= parseFloat(dia.Total).toLocaleString('es-CR') %>
                                <span style="color:#6c757d; font-weight:normal;">
                                    (<%= dia.Ventas %> venta<%= dia.Ventas !== 1 ? 's' : '' %>)
                                </span>
                            </span>
                        </div>
                        <div style="background:#e9ecef; border-radius:4px; height:10px;">
                            <div style="background:#28a745; width:<%= pct %>%; height:10px; border-radius:4px;"></div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div style="text-align:center; padding:30px; color:#6c757d;">
                    <i class="fas fa-chart-bar" style="font-size:2rem; margin-bottom:10px; display:block; opacity:0.3;"></i>
                    No hay ventas en los últimos 7 días.
                </div>
            <% } %>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="card-title">Estado de Citas</h2>
        </div>
        <div style="padding:16px;">
            <% const totalC = citas.TotalCitas || 0; %>
            <% if (totalC > 0) { %>
                <%
                const estados = [
                    { label: 'Pendientes',  valor: citas.Pendientes  || 0, color: '#fd7e14' },
                    { label: 'Confirmadas', valor: citas.Confirmadas || 0, color: '#28a745' },
                    { label: 'Canceladas',  valor: citas.Canceladas  || 0, color: '#dc3545' }
                ];
                %>
                <% estados.forEach(e => { %>
                    <% const pct = Math.round((e.valor / totalC) * 100); %>
                    <div style="margin-bottom:14px;">
                        <div style="display:flex; justify-content:space-between; font-size:0.82em; margin-bottom:4px;">
                            <span><%= e.label %></span>
                            <span style="font-weight:bold;"><%= e.valor %> (<%= pct %>%)</span>
                        </div>
                        <div style="background:#e9ecef; border-radius:4px; height:10px;">
                            <div style="background:<%= e.color %>; width:<%= pct %>%; height:10px; border-radius:4px;"></div>
                        </div>
                    </div>
                <% }) %>
                <div style="text-align:center; margin-top:16px;">
                    <a href="/citas" class="btn btn-secondary" style="font-size:0.85em;">Ver todas las citas →</a>
                </div>
            <% } else { %>
                <div style="text-align:center; padding:30px; color:#6c757d;">
                    <i class="fas fa-calendar" style="font-size:2rem; margin-bottom:10px; display:block; opacity:0.3;"></i>
                    No hay citas registradas.
                </div>
            <% } %>
        </div>
    </div>
</div>

<div class="card" style="margin-bottom:24px;">
    <div class="card-header">
        <h2 class="card-title">Productos Más Vendidos</h2>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Producto</th>
                <th>Categoría</th>
                <th>Unidades Vendidas</th>
                <th>Ingresos Generados</th>
            </tr>
        </thead>
        <tbody>
            <% if (topProductos && topProductos.length > 0) { %>
                <% topProductos.forEach((p, i) => { %>
                    <tr>
                        <td>
                            <strong style="color:<%= i === 0 ? '#ffc107' : i === 1 ? '#6c757d' : i === 2 ? '#fd7e14' : 'inherit' %>;">
                                <%= i + 1 %>
                            </strong>
                        </td>
                        <td><strong><%= p.Nombre %></strong></td>
                        <td><span class="category-badge"><%= p.Categoria %></span></td>
                        <td><%= p.UnidadesVendidas %></td>
                        <td>₡<%= parseFloat(p.Ingresos).toLocaleString('es-CR') %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="5" style="text-align:center; padding:30px; color:#6c757d;">
                        <i class="fas fa-box-open" style="font-size:2rem; display:block; margin-bottom:8px; opacity:0.3;"></i>
                        No hay ventas de productos registradas aún.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Top Clientes por Gasto</h2>
    </div>
    <table class="table">
        <thead>
            <tr>
                <th>#</th>
                <th>Cliente</th>
                <th>Compras Realizadas</th>
                <th>Total Gastado</th>
            </tr>
        </thead>
        <tbody>
            <% if (topClientes && topClientes.length > 0) { %>
                <% topClientes.forEach((c, i) => { %>
                    <tr>
                        <td>
                            <strong style="color:<%= i === 0 ? '#ffc107' : i === 1 ? '#6c757d' : i === 2 ? '#fd7e14' : 'inherit' %>;">
                                <%= i + 1 %>
                            </strong>
                        </td>
                        <td><strong><%= c.Cliente %></strong></td>
                        <td><%= c.Compras %></td>
                        <td>₡<%= parseFloat(c.TotalGastado).toLocaleString('es-CR') %></td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="4" style="text-align:center; padding:30px; color:#6c757d;">
                        <i class="fas fa-users" style="font-size:2rem; display:block; margin-bottom:8px; opacity:0.3;"></i>
                        No hay clientes con compras registradas aún.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<script>
    async function registrarAccionReporte(codigoEvento, nombreEvento, detalle, datos = {}) {
        try {
            await fetch('/reportes/accion', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ codigoEvento, nombreEvento, detalle, datos }),
                keepalive: true
            });
        } catch (e) { console.error('Error registrando acción:', e); }
    }

    function exportarPDF() {
        registrarAccionReporte('REP_EXPORTAR_PDF', 'Exportación de reporte en PDF', 'El usuario exportó el panel de reportes en PDF');
        window.print();
    }

    function imprimirReporte() {
        registrarAccionReporte('REP_IMPRIMIR', 'Impresión de reporte', 'El usuario imprimió el panel de reportes');
        window.print();
    }
</script>
