<% title = 'Reportes y Estadísticas' %>

<div class="page-header">
    <h1 class="page-title">Reportes y Estadísticas</h1>
    <p class="page-subtitle">Análisis y reportes del sistema</p>
</div>

<div class="filters-row">
    <div class="form-group">
        <label class="form-label">Tipo de Reporte</label>
        <select class="form-control" id="tipoReporte">
            <option value="ventas">Ventas</option>
            <option value="citas">Citas</option>
            <option value="inventario">Inventario</option>
            <option value="clientes">Clientes</option>
        </select>
    </div>

    <div class="form-group">
        <label class="form-label">Fecha Desde</label>
        <input type="date" class="form-control" id="fechaDesde">
    </div>

    <div class="form-group">
        <label class="form-label">Fecha Hasta</label>
        <input type="date" class="form-control" id="fechaHasta">
    </div>

    <div class="form-group filters-row-actions">
        <button class="btn btn-primary" onclick="generarReporte()">
            <i class="fas fa-chart-bar"></i> Generar Reporte
        </button>
    </div>
</div>

<div class="report-actions">
    <button class="btn btn-secondary" onclick="location.href='/reportes/historial'">
        <i class="fas fa-history"></i> Historial de Movimientos
    </button>
    <button class="btn btn-success" onclick="exportarPDF()">
        <i class="fas fa-file-pdf"></i> Exportar PDF
    </button>
    <button class="btn btn-success" onclick="exportarExcel()">
        <i class="fas fa-file-excel"></i> Exportar Excel
    </button>
    <button class="btn btn-primary" onclick="imprimirReporte()">
        <i class="fas fa-print"></i> Imprimir
    </button>
</div>

<div class="reports-container">
    <div>
        <div class="chart-container">
            <h3 class="chart-title">Ventas por Día - Octubre 2024</h3>
            <div class="chart-placeholder">
                <div class="chart-placeholder-inner">
                    <i class="fas fa-chart-line chart-placeholder-icon"></i>
                    <div>Gráfico de Ventas por Día</div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h2 class="card-title">Productos Más Vendidos</h2>
            </div>

            <table class="table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Unidades Vendidas</th>
                        <th>Ingresos</th>
                        <th>Tendencia</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Antipulgas para perros grandes</td>
                        <td><span class="category-badge">Medicamento</span></td>
                        <td>28</td>
                        <td>$700.00</td>
                        <td><span class="trend-up">↗ 15%</span></td>
                    </tr>
                    <tr>
                        <td>Alimento para perros adulto 5kg</td>
                        <td><span class="category-badge">Alimento</span></td>
                        <td>25</td>
                        <td>$462.50</td>
                        <td><span class="trend-up">↗ 8%</span></td>
                    </tr>
                    <tr>
                        <td>Arena para gatos absorbente 4kg</td>
                        <td><span class="category-badge">Accesorio</span></td>
                        <td>22</td>
                        <td>$264.00</td>
                        <td><span class="trend-up">↗ 12%</span></td>
                    </tr>
                    <tr>
                        <td>Vacuna triple felina</td>
                        <td><span class="category-badge">Medicamento</span></td>
                        <td>18</td>
                        <td>$630.00</td>
                        <td><span class="trend-neutral">→ 0%</span></td>
                    </tr>
                    <tr>
                        <td>Shampoo medicado para perros</td>
                        <td><span class="category-badge">Higiene</span></td>
                        <td>15</td>
                        <td>$150.00</td>
                        <td><span class="trend-down">↘ 5%</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="quick-stats">
        <div class="quick-stat">
            <div class="stat-icon-large bg-cyan">
                <i class="fas fa-dollar-sign"></i>
            </div>
            <div class="quick-stat-value">$8,450</div>
            <div class="quick-stat-label">Ventas Totales</div>
            <div class="quick-stat-trend trend-up">+12% vs mes anterior</div>
        </div>

        <div class="quick-stat">
            <div class="stat-icon-large bg-green">
                <i class="fas fa-shopping-cart"></i>
            </div>
            <div class="quick-stat-value">42</div>
            <div class="quick-stat-label">Ventas Realizadas</div>
            <div class="quick-stat-trend trend-up">+8% vs mes anterior</div>
        </div>

        <div class="quick-stat">
            <div class="stat-icon-large bg-orange">
                <i class="fas fa-calendar-check"></i>
            </div>
            <div class="quick-stat-value">18</div>
            <div class="quick-stat-label">Citas Atendidas</div>
            <div class="quick-stat-trend trend-up">+15% vs mes anterior</div>
        </div>

        <div class="quick-stat">
            <div class="stat-icon-large bg-red">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="quick-stat-value">5</div>
            <div class="quick-stat-label">Productos Bajos en Stock</div>
            <div class="quick-stat-trend trend-down">+2 vs mes anterior</div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Resumen de Actividad</h2>
    </div>

    <div class="reports-summary-grid">
        <div>
            <h4 class="reports-subtitle">Top Clientes</h4>
            <table class="table">
                <thead>
                    <tr>
                        <th>Cliente</th>
                        <th>Compras</th>
                        <th>Total Gastado</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>María González</td>
                        <td>8</td>
                        <td>$450.00</td>
                    </tr>
                    <tr>
                        <td>Carlos López</td>
                        <td>6</td>
                        <td>$320.00</td>
                    </tr>
                    <tr>
                        <td>Ana Martínez</td>
                        <td>5</td>
                        <td>$280.00</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div>
            <h4 class="reports-subtitle">Servicios Más Solicitados</h4>
            <table class="table">
                <thead>
                    <tr>
                        <th>Servicio</th>
                        <th>Cantidad</th>
                        <th>Ingresos</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Consulta general</td>
                        <td>25</td>
                        <td>$625.00</td>
                    </tr>
                    <tr>
                        <td>Vacunación</td>
                        <td>18</td>
                        <td>$540.00</td>
                    </tr>
                    <tr>
                        <td>Desparasitación</td>
                        <td>12</td>
                        <td>$240.00</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function generarReporte() {
        const tipoReporte = document.getElementById('tipoReporte').value;
        const fechaDesde = document.getElementById('fechaDesde').value;
        const fechaHasta = document.getElementById('fechaHasta').value;

        alert(`Generando reporte de ${tipoReporte} desde ${fechaDesde || 'N/A'} hasta ${fechaHasta || 'N/A'}`);
    }

    function exportarPDF() {
        alert('Exportando reporte a PDF...');
    }

    function exportarExcel() {
        alert('Exportando reporte a Excel...');
    }

    function imprimirReporte() {
        window.print();
    }
</script>
