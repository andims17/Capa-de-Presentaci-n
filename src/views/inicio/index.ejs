<% title = 'Dashboard'; %>

<div class="page-header">
    <h1 class="page-title">Dashboard</h1>
    <p class="page-subtitle">Resumen general del sistema</p>
</div>

<%# ── Mensaje de error de BD (opcional) ──────────────────────── %>
<% if (typeof error !== 'undefined' && error) { %>
<div style="background:#FEF2F2;border:1px solid #FCA5A5;color:#B91C1C;padding:0.75rem 1rem;border-radius:8px;margin-bottom:1.5rem;">
    <i class="fas fa-exclamation-circle"></i> <%= error %>
</div>
<% } %>

<%# ── Tarjetas de resumen ─────────────────────────────────────── %>
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon bg-cyan">
            <i class="fas fa-cash-register"></i>
        </div>
        <div class="stat-value">
            $<%= Number(resumen.VentasHoy).toLocaleString('es-CR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
        </div>
        <div class="stat-label">Ventas del día</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon bg-green">
            <i class="fas fa-calendar-check"></i>
        </div>
        <div class="stat-value"><%= resumen.CitasHoy %></div>
        <div class="stat-label">Citas hoy</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon bg-orange">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <div class="stat-value"><%= resumen.ProductosBajoStock %></div>
        <div class="stat-label">Productos bajos en stock</div>
    </div>

    <div class="stat-card">
        <div class="stat-icon bg-red">
            <i class="fas fa-paw"></i>
        </div>
        <div class="stat-value"><%= resumen.TotalMascotas %></div>
        <div class="stat-label">Mascotas registradas</div>
    </div>
</div>

<%# ── Tabla: Citas del día ────────────────────────────────────── %>
<div class="card">
    <div class="card-header">
        <h2 class="card-title">Citas del Día</h2>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Hora</th>
                <th>Cliente</th>
                <th>Mascota</th>
                <th>Servicio</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% if (citas.length === 0) { %>
            <tr>
                <td colspan="6" style="text-align:center;color:#6B7280;padding:2rem 0;">
                    <i class="fas fa-calendar-times" style="font-size:1.5rem;margin-bottom:0.5rem;display:block;"></i>
                    No hay citas agendadas para hoy.
                </td>
            </tr>
            <% } else { %>
            <% citas.forEach(cita => { %>
            <tr>
                <td><%= cita.HoraFormateada %></td>
                <td><%= cita.ClienteNombre %></td>
                <td><%= cita.MascotaNombre %> (<%= cita.Especie %>)</td>
                <td><%= cita.Servicio %></td>
                <td>
                    <% if (cita.Estado === 'Confirmada') { %>
                        <span class="badge badge-success">Confirmada</span>
                    <% } else if (cita.Estado === 'Pendiente') { %>
                        <span class="badge badge-warning">Pendiente</span>
                    <% } else if (cita.Estado === 'Cancelada') { %>
                        <span class="badge badge-danger">Cancelada</span>
                    <% } else { %>
                        <span class="badge"><%= cita.Estado %></span>
                    <% } %>
                </td>
                <td>
                    <a href="/citas?id=<%= cita.Id %>"
                       class="btn btn-primary"
                       style="padding:0.3rem 0.6rem;font-size:0.8rem;">
                        <i class="fas fa-edit"></i>
                    </a>
                </td>
            </tr>
            <% }) %>
            <% } %>
        </tbody>
    </table>
