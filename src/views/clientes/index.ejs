<div class="page-header">
    <h1 class="page-title">Gestión de Clientes</h1>
    <p class="page-subtitle">Administra la información de los clientes</p>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Lista de Clientes</h2>
        <div style="display: flex; gap: 1rem;">
            <div class="search-box">
                <input type="text" id="buscadorClientes" class="search-input" placeholder="Buscar cliente...">
                <button class="search-btn"><i class="fas fa-search"></i></button>
            </div>
            <button class="btn btn-primary" onclick="openModal('nuevoClienteModal')">
                <i class="fas fa-plus"></i> Nuevo Cliente
            </button>
        </div>
    </div>

    <div class="clients-grid" id="listaClientes">
        <% if (clientes && clientes.length > 0) { %>
            <% clientes.forEach(cliente => { %>
                <div class="client-card">
                    <div class="client-header">
                        <div class="client-avatar"><%= cliente.NombreCompleto.split(' ').map(n => n[0]).join('') %></div>
                        <div class="client-info">
                            <h3><%= cliente.NombreCompleto %></h3>
                            <p>CLI-<%= cliente.Id.toString().padStart(3, '0') %></p>
                        </div>
                    </div>
                    <div class="client-details">
                        <div class="detail-item">
                            <span class="detail-label">Teléfono:</span>
                            <span class="detail-value"><%= cliente.Telefono || '-' %></span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Email:</span>
                            <span class="detail-value"><%= cliente.Email || '-' %></span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Dirección:</span>
                            <span class="detail-value"><%= cliente.Direccion || '-' %></span>
                        </div>
                    </div>
                    <div class="client-actions">
                        <button type="button" class="btn btn-primary btn-sm"
                            onclick="openEditModal(<%= cliente.Id %>, '<%= encodeURIComponent(cliente.NombreCompleto) %>', '<%= encodeURIComponent(cliente.Telefono || '') %>', '<%= encodeURIComponent(cliente.Email || '') %>', '<%= encodeURIComponent(cliente.Direccion || '') %>')">
                            <i class="fas fa-edit"></i> Editar
                        </button>
                        <a href="/clientes/ver/<%= cliente.Id %>" class="btn btn-info btn-sm">
                            <i class="fas fa-eye"></i> Ver
                        </a>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <p>No hay clientes registrados.</p>
        <% } %>
    </div>
</div>

<!-- Modal de Nuevo Cliente -->
<div id="nuevoClienteModal" class="modal">
    <div class="modal-content card">
        <div class="modal-header">
            <h3 class="modal-title">Registrar Nuevo Cliente</h3>
            <button class="close" onclick="closeModal('nuevoClienteModal')">&times;</button>
        </div>
        <form action="/clientes/crear" method="POST">
            <div class="form-group">
                <label class="form-label">Nombre</label>
                <input type="text" name="NombreCompleto" class="form-control" placeholder="Nombre completo" required>
            </div>
            <div class="form-group">
                <label class="form-label">Teléfono</label>
                <input type="tel" name="Telefono" class="form-control" placeholder="Número de teléfono">
            </div>
            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" name="Email" class="form-control" placeholder="Correo electrónico">
            </div>
            <div class="form-group">
                <label class="form-label">Dirección</label>
                <textarea name="Direccion" class="form-control" rows="2" placeholder="Dirección completa"></textarea>
            </div>
            <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                <button type="button" class="btn btn-secondary" onclick="closeModal('nuevoClienteModal')">Cancelar</button>
                <button type="submit" class="btn btn-primary">Registrar Cliente</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal de Editar Cliente -->
<div id="editarClienteModal" class="modal">
    <div class="modal-content card">
        <div class="modal-header">
            <h3 class="modal-title">Editar Cliente</h3>
            <button class="close" onclick="closeModal('editarClienteModal')">&times;</button>
        </div>
        <form id="formEditarCliente" method="POST">
            <input type="hidden" name="Id" id="editarIdCliente">
            <div class="form-group">
                <label class="form-label">Nombre</label>
                <input type="text" name="NombreCompleto" id="editarNombreCliente" class="form-control" required>
            </div>
            <div class="form-group">
                <label class="form-label">Teléfono</label>
                <input type="tel" name="Telefono" id="editarTelefonoCliente" class="form-control">
            </div>
            <div class="form-group">
                <label class="form-label">Email</label>
                <input type="email" name="Email" id="editarEmailCliente" class="form-control">
            </div>
            <div class="form-group">
                <label class="form-label">Dirección</label>
                <textarea name="Direccion" id="editarDireccionCliente" class="form-control" rows="2"></textarea>
            </div>
            <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                <button type="button" class="btn btn-secondary" onclick="closeModal('editarClienteModal')">Cancelar</button>
                <button type="submit" class="btn btn-primary">Actualizar Cliente</button>
            </div>
        </form>
    </div>
</div>

<script>
function openModal(id) { document.getElementById(id).style.display = 'block'; }
function closeModal(id) { document.getElementById(id).style.display = 'none'; }

function openEditModal(id, nombre, telefono, email, direccion) {
    document.getElementById('editarIdCliente').value = id;
    document.getElementById('editarNombreCliente').value = decodeURIComponent(nombre);
    document.getElementById('editarTelefonoCliente').value = decodeURIComponent(telefono);
    document.getElementById('editarEmailCliente').value = decodeURIComponent(email);
    document.getElementById('editarDireccionCliente').value = decodeURIComponent(direccion);
    document.getElementById('formEditarCliente').action = '/clientes/editar/' + id;
    openModal('editarClienteModal');
}

</script>
